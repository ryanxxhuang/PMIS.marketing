---
// Landing。
// 段落順序:原 handoff README 把創辦人段放在第二段當最強說服點,
// 2026-08-25 依使用者要求改為簡化後置於 FAQ 與 CTA 之間。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/landing/Hero.astro';
import Workload from '../components/landing/Workload.astro';
import DraftProvenance from '../components/landing/DraftProvenance.astro';
import Founder from '../components/landing/Founder.astro';
import Roles from '../components/landing/Roles.astro';
import Worksurfaces from '../components/landing/Worksurfaces.astro';
import RedLines from '../components/landing/RedLines.astro';
import SecurityAudit from '../components/landing/SecurityAudit.astro';
import Faq from '../components/landing/Faq.astro';
import Cta from '../components/landing/Cta.astro';
---

<Base
  title="GovAgent — 公共工程專案管理系統（PMIS）"
  description="GovAgent 把 PCCES 標單、施工日誌、查驗、估驗計價與送審接成一條資料鏈。AI 只做查詢、彙整與草稿；核定、判定、結案與驗收，永遠是人的。"
>
  <Header page="landing" />
  <main id="main" tabindex="-1">
    <Hero />
    <Workload />
    <DraftProvenance />
    <Roles />
    <Worksurfaces />
    <RedLines />
    <SecurityAudit />
    <Faq />
    <Founder />
    <Cta />
  </main>
  <Footer />
</Base>
