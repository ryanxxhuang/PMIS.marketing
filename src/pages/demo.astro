---
// 預約示範:1fr 380px 兩欄(980px 以下單欄),左邊 18px 圓角白色大卡表單。
// 表單狀態與驗證邏輯照原型底部的 DCLogic class 轉譯:
//   state = { role:'supervisor', picked:[], name, org, email, sent }
//   ready = name && org && /.+@.+\..+/.test(email)
// 後端:POST 到 Supabase Edge Function demo-request(見 config.ts 的 DEMO_API)。
// 機器人防護:蜜罐欄位 + 開頁到送出的最短時間,由 function 端靜默丟棄。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE, DEMO_API } from '../config';

const roles = [
  { id: 'supervisor', label: '監造單位', icon: 'rate_review', desc: '建築師事務所、工程顧問公司', org: '事務所／公司名稱（必填）' },
  { id: 'owner', label: '機關業主', icon: 'account_balance', desc: '主辦機關承辦人或主管', org: '機關名稱（必填）' },
  { id: 'contractor', label: '施工廠商', icon: 'engineering', desc: '營造廠專案人員', org: '公司名稱（必填）' },
];

const topics = ['監造報表重複打字', '估驗計價對帳', '契約期限追蹤', '查驗與缺失管理', '三方文件版本混亂', '跨案進度掌握'];

const steps = [
  { num: '01', title: '匯入你的標單或契約', desc: 'PCCES XML、PDF 或 Word' },
  { num: '02', title: '看 AI 抽出的履約要求', desc: '附條號、頁碼與信賴度，逐條核定' },
  { num: '03', title: '跑一期估驗計價', desc: '數量、累計百分比與金額由引擎計算' },
  { num: '04', title: '看三方各自的畫面', desc: '同一份資料，三種可見範圍' },
];

const concerns = [
  { q: '會不會被推銷？', a: '不會。示範就是操作系統，看完覺得不適合直接說。' },
  { q: '要準備什麼？', a: '一份標單或契約就夠。沒有也可以用示範案走一次。' },
  { q: '資料會外流嗎？', a: null }, // 內含連結,寫在模板裡
];
---

<Base
  title="預約線上示範 — GovAgent"
  description="給公共工程機關、監造與廠商的線上示範：帶你自己的標單或契約，30 分鐘看一次 AI 抽出履約要求、跑一期估驗計價與三方畫面，不用先簽約。"
>
  <Header page="demo" />
  <main id="main" tabindex="-1" class="demo-main">
    <div class="demo-grid">
      <div class="form-card">
        {/* 成功區塊在 DOM 中排在 form 之前,所以這裡用 h1 而不是 h2:
            同頁兩個 h1 但永遠只有一個可見,送出後這句才是本頁的標題。
            tabindex="-1" 供送出成功後把焦點移進來(見下方 script)。 */}
        <div class="form-success" hidden>
          <Icon name="check_circle" size={44} fill class="success-icon" />
          <h1 class="success-title" tabindex="-1">已收到，我會在一個工作日內回信</h1>
          <p class="success-desc">回信會附上兩、三個可以的時段，以及示範前要準備的東西（一份 PCCES 標單或契約 PDF 就夠）。</p>
          <button type="button" class="again-btn">再填一份</button>
        </div>

        <form class="form-body" novalidate>
          <h1 class="form-title" tabindex="-1">預約線上示範</h1>
          <p class="form-lede">30 分鐘，帶你自己的案子看一次。不用先簽任何東西。</p>

          <div class="role-group">
            <div class="group-label" id="role-group-label">你在專案裡是哪一方？</div>
            <div class="role-grid" role="group" aria-labelledby="role-group-label">
              {
                roles.map((r, i) => (
                  <button
                    type="button"
                    class:list={['role-btn', { 'is-on': i === 0 }]}
                    data-role={r.id}
                    data-org={r.org}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <Icon name={r.icon} size={24} class="role-icon" />
                    <span class="role-label">{r.label}</span>
                    <span class="role-desc">{r.desc}</span>
                    <Icon name="check_circle" size={19} class="role-check" />
                  </button>
                ))
              }
            </div>
          </div>

          <div class="fields">
            <label class="fld-wrap">
              <span class="fld-label">姓名（必填）</span>
              <input class="fld" name="name" autocomplete="name" required />
            </label>
            <label class="fld-wrap">
              <span class="fld-label" data-org-label>事務所／公司名稱（必填）</span>
              <input class="fld" name="org" autocomplete="organization" required />
            </label>
            <label class="fld-wrap">
              <span class="fld-label">公務／公司信箱（必填）</span>
              <input class="fld" name="email" type="email" autocomplete="email" required />
            </label>
            <label class="fld-wrap">
              <span class="fld-label">聯絡電話（選填）</span>
              <input class="fld" name="phone" autocomplete="tel" />
            </label>
          </div>

          <div class="topics-group">
            <div class="group-label" id="topics-group-label">現在最想解決的事（可多選）</div>
            <div class="topics" role="group" aria-labelledby="topics-group-label">
              {
                topics.map((t) => (
                  <button type="button" class="topic-chip" data-topic={t} aria-pressed="false">
                    <Icon name="check" size={15} class="topic-check" />{t}
                  </button>
                ))
              }
            </div>
          </div>

          <label class="fld-wrap note-wrap">
            <span class="fld-label">案子的狀況與想看的重點（選填）</span>
            <textarea class="fld" name="note" rows="4"></textarea>
          </label>

          <div class="privacy">
            <Icon name="lock" size={18} class="privacy-icon" />
            <p class="privacy-text">你填的資料只用於安排這次示範與後續聯絡，不會提供給第三方。示範用的標單與契約在示範結束後可要求刪除。</p>
          </div>

          {/* 蜜罐:真人看不到也 tab 不到;機器人填了就會被 function 靜默丟棄 */}
          <div class="hp" aria-hidden="true">
            <label>
              網站
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="submit-error" role="alert" hidden>
            <Icon name="error" size={18} class="submit-error-icon" />
            <span class="submit-error-text"></span>
            <button type="button" class="retry-btn">重試</button>
          </div>

          <div class="submit-row">
            <button type="submit" class="submit-btn" aria-describedby="submit-hint" disabled>
              送出預約<Icon name="arrow_forward" size={19} class="submit-icon" /><Icon name="progress_activity" size={19} class="submit-spin" />
            </button>
            <span class="submit-hint" id="submit-hint" role="status">姓名、單位與信箱填完就能送出</span>
          </div>
        </form>
      </div>

      <aside class="demo-aside">
        <div class="aside-card">
          <h2 class="aside-title">示範會走完這四步</h2>
          <div class="aside-steps">
            {
              steps.map((s) => (
                <div class="aside-step">
                  <span class="num aside-step-num">{s.num}</span>
                  <div>
                    <div class="aside-step-title">{s.title}</div>
                    <div class="aside-step-desc">{s.desc}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="aside-card">
          <h2 class="aside-title">常見的疑慮</h2>
          <div class="aside-concerns">
            <div>
              <div class="concern-q">{concerns[0].q}</div>
              <p class="concern-a">{concerns[0].a}</p>
            </div>
            <div>
              <div class="concern-q">{concerns[1].q}</div>
              <p class="concern-a">{concerns[1].a}</p>
            </div>
            <div>
              <div class="concern-q">資料會外流嗎？</div>
              <p class="concern-a">示範用的檔案可在結束後要求刪除，資安說明見<a href="/security/">這一頁</a>。</p>
            </div>
          </div>
        </div>

        <div class="aside-mail">
          <p>不想填表？直接寄信給我：<a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
<script>
  import { DEMO_API } from '../config';

  const form = document.querySelector<HTMLFormElement>('.form-body')!;
  const success = document.querySelector<HTMLElement>('.form-success')!;
  const roleBtns = [...document.querySelectorAll<HTMLButtonElement>('.role-btn')];
  const orgLabel = document.querySelector<HTMLElement>('[data-org-label]')!;
  const topicBtns = [...document.querySelectorAll<HTMLButtonElement>('.topic-chip')];
  const nameInput = form.querySelector<HTMLInputElement>('[name="name"]')!;
  const orgInput = form.querySelector<HTMLInputElement>('[name="org"]')!;
  const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn')!;
  const hint = form.querySelector<HTMLElement>('.submit-hint')!;
  const againBtn = document.querySelector<HTMLButtonElement>('.again-btn')!;
  const successTitle = success.querySelector<HTMLElement>('.success-title')!;
  const formTitle = form.querySelector<HTMLElement>('.form-title')!;

  const ready = () =>
    nameInput.value.trim() !== '' &&
    orgInput.value.trim() !== '' &&
    /.+@.+\..+/.test(emailInput.value);

  const refresh = () => {
    const ok = ready();
    submitBtn.disabled = !ok;
    hint.textContent = ok ? '一個工作日內回信' : '姓名、單位與信箱填完就能送出';
  };

  roleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      roleBtns.forEach((b) => {
        b.classList.toggle('is-on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      orgLabel.textContent = btn.dataset.org ?? '';
    });
  });

  topicBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const on = btn.classList.toggle('is-on');
      btn.setAttribute('aria-pressed', String(on));
    });
  });

  [nameInput, orgInput, emailInput].forEach((el) => el.addEventListener('input', refresh));

  // ---- 送出:POST 到 Supabase Edge Function ----
  // 錯誤文案比照產品 errorMessage.js:網路層講清楚、伺服器的繁中業務訊息原樣顯示、
  // 其餘一律通用訊息 + 代碼,不外洩原始錯誤。
  const errorBox = form.querySelector<HTMLElement>('.submit-error')!;
  const errorText = form.querySelector<HTMLElement>('.submit-error-text')!;
  const retryBtn = form.querySelector<HTMLButtonElement>('.retry-btn')!;
  const honeypot = form.querySelector<HTMLInputElement>('[name="website"]')!;
  const phoneInput = form.querySelector<HTMLInputElement>('[name="phone"]')!;
  const noteInput = form.querySelector<HTMLTextAreaElement>('[name="note"]')!;
  const CJK = /[㐀-鿿豈-﫿]/;
  const openedAt = Date.now();
  let submitting = false;

  // 先讓 role="alert" 進入無障礙樹,再寫入內容,螢幕閱讀器才會播報
  const showError = (msg: string) => {
    errorBox.hidden = false;
    errorText.textContent = msg;
  };

  const doSubmit = async () => {
    if (submitting) return;
    submitting = true;
    errorBox.hidden = true;
    submitBtn.disabled = true;
    submitBtn.classList.add('is-loading');
    try {
      const activeRole = document.querySelector<HTMLElement>('.role-btn.is-on');
      const res = await fetch(DEMO_API.endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${DEMO_API.anonKey}`,
          apikey: DEMO_API.anonKey,
        },
        body: JSON.stringify({
          role: activeRole?.dataset.role ?? 'supervisor',
          name: nameInput.value.trim(),
          org: orgInput.value.trim(),
          email: emailInput.value.trim(),
          phone: phoneInput.value.trim(),
          topics: [...document.querySelectorAll<HTMLElement>('.topic-chip.is-on')].map((b) => b.dataset.topic ?? ''),
          note: noteInput.value.trim(),
          website: honeypot.value,
          elapsed_ms: Date.now() - openedAt,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const serverMsg = typeof data?.error === 'string' && CJK.test(data.error) ? data.error : null;
        showError(serverMsg ?? `預約未送出，請稍後再試。（代碼 ${res.status}）`);
        return;
      }
      form.hidden = true;
      success.hidden = false;
      // 表單一藏起來,文件高度會塌掉(手機 2632→1622px),瀏覽器把 scrollY 夾回去後
      // 成功訊息會落在視窗上方看不到的地方 —— 送出後完全沒有回饋。
      // 焦點移進標題同時解決兩件事:視覺上把這一塊帶到眼前,螢幕閱讀器也會念出
      // 「已收到…」(唯一的 role="status" 在已 hidden 的 form 裡,不會播報)。
      successTitle.focus();
      success.scrollIntoView({ block: 'center' });
    } catch {
      showError('網路連線不穩，請確認連線後再試一次。');
    } finally {
      submitting = false;
      submitBtn.classList.remove('is-loading');
      refresh();
    }
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!ready()) return;
    doSubmit();
  });
  retryBtn.addEventListener('click', () => {
    if (ready()) doSubmit();
  });

  // 原型 reset:清 name/org/email 與已選議題,身分保留
  againBtn.addEventListener('click', () => {
    // 電話與備註也要清 —— 否則下一位填表的人會帶著前一位的資料送出
    [nameInput, orgInput, emailInput, phoneInput, noteInput].forEach((el) => (el.value = ''));
    topicBtns.forEach((b) => {
      b.classList.remove('is-on');
      b.setAttribute('aria-pressed', 'false');
    });
    refresh();
    success.hidden = true;
    form.hidden = false;
    // 回到表單同樣要把焦點帶回來(否則 activeElement 變成 BODY)。
    // 送焦點到 h1 而不是第一個輸入框:不會在手機上硬叫出虛擬鍵盤,螢幕閱讀器會
    // 重念一次「預約線上示範」,而且捲到表單頂端看得到仍保留的身分選擇;
    // 接著按 Tab 是身分三選一 → 姓名,順序自然。
    formTitle.focus();
    form.scrollIntoView({ block: 'start' });
  });

  refresh();
</script>
</Base>

<style>
  /* 整頁坐在 --bg 灰底上,表單是白面大卡——這頁的「產品畫面」就是表單本身。
     文字色對 --surface 的實算:--text 16.83、--text-2 7.31、--text-3 5.54、--blue-text 6.95;
     對 --bg:--text-2 6.71、--text-3 5.09。 */
  .demo-main { background: var(--bg); }

  .demo-grid {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 64px) 24px clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 44px;
    align-items: start;
  }

  /* ---------- 表單大卡(規範 §4:登入卡 18px 圓角;白面 + 半像素描邊 + 輕影) ---------- */

  .form-card {
    background: var(--surface);
    border-radius: 18px;
    box-shadow: var(--shadow-md);
    padding: 40px 44px 36px;
  }

  .form-title {
    font-size: var(--text-title1);
    line-height: var(--text-title1--line-height);
    letter-spacing: var(--text-title1--letter-spacing);
  }

  /* 「再填一份」捲回表單時用 block:'start';站頂是 52px 的 sticky header,
     留 80px 讓標題不會被壓在它下面 */
  .form-body { scroll-margin-top: 80px; }

  .form-lede {
    margin-top: 12px;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .group-label {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .role-group { margin-top: 30px; }
  .topics-group { margin-top: 24px; }

  /* 身分三選一 */
  .role-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .role-btn {
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    font-family: var(--font-body);
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .role-btn:not(.is-on):hover { background: var(--surface-2); }
  /* 選取態:2px 主色框 + 淺藍底;padding 減 1px 抵銷邊框增量,尺寸不跳動 */
  .role-btn.is-on {
    background: var(--blue-tint);
    border: 2px solid var(--blue);
    padding: 15px;
  }
  .role-icon { color: var(--text-3); }
  /* 選取態:主色 + 描邊加重一階(lucide 沒有 FILL 軸,同 Icon.astro 的 fill 規則);圖示走 3:1 圖形門檻 */
  .role-btn.is-on .role-icon {
    color: var(--blue);
    stroke-width: 2.25;
  }
  .role-label {
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-weight: 600;
  }
  .role-desc {
    font-size: var(--text-footnote);
    letter-spacing: var(--text-footnote--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-3); /* 對 --blue-tint 4.86,選取態也過 */
  }
  .role-check {
    position: absolute;
    top: 12px;
    right: 12px;
    color: var(--blue);
    display: none;
  }
  .role-btn.is-on .role-check { display: inline-block; }

  /* 標籤在上的輸入框(規範 §4:大輸入 10px 圓角)。與產品 ui.jsx 的 Field 同一形狀——
     Material 的「標籤切進框線」是 Google 時代殘留,Apple 的表單標籤不切框線。 */
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 26px;
  }
  .fld-wrap { display: block; }
  .fld {
    width: 100%;
    box-sizing: border-box;
    height: 52px;
    padding: 0 16px;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-body);
    outline: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .fld:focus { border-color: var(--blue); }
  /* README a11y:focus-visible 一律 2px 主色外框(outline:none 只擋滑鼠 focus) */
  .fld:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  textarea.fld {
    height: auto;
    padding: 14px 16px;
    line-height: var(--leading-prose);
    resize: vertical;
  }
  .fld-label {
    display: block;
    margin-bottom: 6px;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    font-weight: 500;
    color: var(--text); /* 對 --surface 白底 21:1(規範 §2) */
  }
  .note-wrap { margin-top: 26px; }

  /* 議題 chip(可多選) */
  .topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .topic-chip {
    height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .topic-chip:not(.is-on):hover { background: var(--surface-2); }
  .topic-chip.is-on {
    background: var(--blue-tint);
    border-color: var(--blue);
    color: var(--blue-text); /* 對 --blue-tint 6.10 */
  }
  .topic-check { display: none; }
  .topic-chip.is-on .topic-check { display: inline-block; }

  .privacy {
    margin-top: 22px;
    padding: 14px 16px;
