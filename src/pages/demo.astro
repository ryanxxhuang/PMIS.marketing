---
// 預約示範:1fr 380px 兩欄(980px 以下單欄),左邊 28px 圓角白色大卡表單。
// 表單狀態與驗證邏輯照原型底部的 DCLogic class 轉譯:
//   state = { role:'supervisor', picked:[], name, org, email, sent }
//   ready = name && org && /.+@.+\..+/.test(email)
// 後端:POST 到 Supabase Edge Function demo-request(見 config.ts 的 DEMO_API)。
// 機器人防護:蜜罐欄位 + 開頁到送出的最短時間,由 function 端靜默丟棄。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, DEMO_API } from '../config';

const roles = [
  { id: 'supervisor', label: '監造單位', icon: 'rate_review', desc: '技師事務所、工程顧問公司', org: '事務所／公司名稱（必填）' },
  { id: 'owner', label: '機關業主', icon: 'account_balance', desc: '主辦機關承辦人或主管', org: '機關名稱（必填）' },
  { id: 'contractor', label: '施工廠商', icon: 'engineering', desc: '營造廠專案人員', org: '公司名稱（必填）' },
];

const topics = ['監造報表重複打字', '估驗計價對帳', '契約期限追蹤', '查驗與缺失管理', '三方文件版本混亂', '跨案進度掌握'];

const steps = [
  { num: '01', title: '匯入你的標單或契約', desc: 'PCCES XML、PDF 或 Word' },
  { num: '02', title: '看 AI 抽出的履約要求', desc: '附條號、頁碼與信賴度，逐條核定' },
  { num: '03', title: '跑一期估驗計價', desc: '數量、累計百分比與金額由引擎計算' },
  { num: '04', title: '看三方各自的畫面', desc: '同一份資料，三種可見範圍' },
];

const concerns = [
  { q: '會不會被推銷？', a: '不會。示範就是操作系統，看完覺得不適合直接說。' },
  { q: '要準備什麼？', a: '一份標單或契約就夠。沒有也可以用示範案走一次。' },
  { q: '資料會外流嗎？', a: null }, // 內含連結,寫在模板裡
];
---

<Base
  title="預約線上示範 — PMIS.ai"
  description="給監造顧問公司與機關承辦人的線上示範：帶你自己的標單或契約，30 分鐘看一次 AI 抽出履約要求、跑一期估驗計價與三方畫面，不用先簽約。"
>
  <Header page="demo" />
  <main id="main" tabindex="-1" class="demo-main">
    <div class="demo-grid">
      <div class="form-card">
        <div class="form-success" hidden>
          <span class="msy msy-f success-icon" aria-hidden="true">check_circle</span>
          <h2 class="success-title">已收到，我會在一個工作日內回信</h2>
          <p class="success-desc">回信會附上兩、三個可以的時段，以及示範前要準備的東西（一份 PCCES 標單或契約 PDF 就夠）。</p>
          <button type="button" class="again-btn">再填一份</button>
        </div>

        <form class="form-body" novalidate>
          <h1 class="form-title">預約線上示範</h1>
          <p class="form-lede">30 分鐘，帶你自己的案子看一次。不用先簽任何東西。</p>

          <div class="role-group">
            <div class="group-label" id="role-group-label">你在專案裡是哪一方？</div>
            <div class="role-grid" role="group" aria-labelledby="role-group-label">
              {
                roles.map((r, i) => (
                  <button
                    type="button"
                    class:list={['role-btn', { 'is-on': i === 0 }]}
                    data-role={r.id}
                    data-org={r.org}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <span class="msy role-icon" aria-hidden="true">{r.icon}</span>
                    <span class="role-label">{r.label}</span>
                    <span class="role-desc">{r.desc}</span>
                    <span class="msy role-check" aria-hidden="true">check_circle</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="fields">
            <label class="fld-wrap">
              <input class="fld" name="name" placeholder=" " autocomplete="name" required />
              <span class="fld-label">姓名（必填）</span>
            </label>
            <label class="fld-wrap">
              <input class="fld" name="org" placeholder=" " autocomplete="organization" required />
              <span class="fld-label" data-org-label>事務所／公司名稱（必填）</span>
            </label>
            <label class="fld-wrap">
              <input class="fld" name="email" type="email" placeholder=" " autocomplete="email" required />
              <span class="fld-label">公務／公司信箱（必填）</span>
            </label>
            <label class="fld-wrap">
              <input class="fld" name="phone" placeholder=" " autocomplete="tel" />
              <span class="fld-label">聯絡電話（選填）</span>
            </label>
          </div>

          <div class="topics-group">
            <div class="group-label" id="topics-group-label">現在最想解決的事（可多選）</div>
            <div class="topics" role="group" aria-labelledby="topics-group-label">
              {
                topics.map((t) => (
                  <button type="button" class="topic-chip" data-topic={t} aria-pressed="false">
                    <span class="msy topic-check" aria-hidden="true">check</span>{t}
                  </button>
                ))
              }
            </div>
          </div>

          <label class="fld-wrap note-wrap">
            <textarea class="fld" name="note" rows="4" placeholder=" "></textarea>
            <span class="fld-label">案子的狀況與想看的重點（選填）</span>
          </label>

          <div class="privacy">
            <span class="msy privacy-icon" aria-hidden="true">lock</span>
            <p class="privacy-text">你填的資料只用於安排這次示範與後續聯絡，不會提供給第三方。示範用的標單與契約在示範結束後可要求刪除。</p>
          </div>

          {/* 蜜罐:真人看不到也 tab 不到;機器人填了就會被 function 靜默丟棄 */}
          <div class="hp" aria-hidden="true">
            <label>
              網站
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="submit-error" role="alert" hidden>
            <span class="msy submit-error-icon" aria-hidden="true">error</span>
            <span class="submit-error-text"></span>
            <button type="button" class="retry-btn">重試</button>
          </div>

          <div class="submit-row">
            <button type="submit" class="submit-btn" aria-describedby="submit-hint" disabled>
              送出預約<span class="msy submit-icon" aria-hidden="true">arrow_forward</span><span class="msy submit-spin" aria-hidden="true">progress_activity</span>
            </button>
            <span class="submit-hint" id="submit-hint" role="status">姓名、單位與信箱填完就能送出</span>
          </div>
        </form>
      </div>

      <aside class="demo-aside">
        <div class="aside-card">
          <h2 class="aside-title">示範會走完這四步</h2>
          <div class="aside-steps">
            {
              steps.map((s) => (
                <div class="aside-step">
                  <span class="num aside-step-num">{s.num}</span>
                  <div>
                    <div class="aside-step-title">{s.title}</div>
                    <div class="aside-step-desc">{s.desc}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="aside-card">
          <h2 class="aside-title">常見的疑慮</h2>
          <div class="aside-concerns">
            <div>
              <div class="concern-q">{concerns[0].q}</div>
              <p class="concern-a">{concerns[0].a}</p>
            </div>
            <div>
              <div class="concern-q">{concerns[1].q}</div>
              <p class="concern-a">{concerns[1].a}</p>
            </div>
            <div>
              <div class="concern-q">資料會外流嗎？</div>
              <p class="concern-a">示範用的檔案可在結束後要求刪除，資安說明見<a href="/security/">這一頁</a>。</p>
            </div>
          </div>
        </div>

        <div class="aside-mail">
          <p>不想填表？直接寄信給我：<a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
<script>
  import { DEMO_API } from '../config';

  const form = document.querySelector<HTMLFormElement>('.form-body')!;
  const success = document.querySelector<HTMLElement>('.form-success')!;
  const roleBtns = [...document.querySelectorAll<HTMLButtonElement>('.role-btn')];
  const orgLabel = document.querySelector<HTMLElement>('[data-org-label]')!;
  const topicBtns = [...document.querySelectorAll<HTMLButtonElement>('.topic-chip')];
  const nameInput = form.querySelector<HTMLInputElement>('[name="name"]')!;
  const orgInput = form.querySelector<HTMLInputElement>('[name="org"]')!;
  const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn')!;
  const hint = form.querySelector<HTMLElement>('.submit-hint')!;
  const againBtn = document.querySelector<HTMLButtonElement>('.again-btn')!;

  const ready = () =>
    nameInput.value.trim() !== '' &&
    orgInput.value.trim() !== '' &&
    /.+@.+\..+/.test(emailInput.value);

  const refresh = () => {
    const ok = ready();
    submitBtn.disabled = !ok;
    hint.textContent = ok ? '一個工作日內回信' : '姓名、單位與信箱填完就能送出';
  };

  roleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      roleBtns.forEach((b) => {
        b.classList.toggle('is-on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      orgLabel.textContent = btn.dataset.org ?? '';
    });
  });

  topicBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const on = btn.classList.toggle('is-on');
      btn.setAttribute('aria-pressed', String(on));
    });
  });

  [nameInput, orgInput, emailInput].forEach((el) => el.addEventListener('input', refresh));

  // ---- 送出:POST 到 Supabase Edge Function ----
  // 錯誤文案比照產品 errorMessage.js:網路層講清楚、伺服器的繁中業務訊息原樣顯示、
  // 其餘一律通用訊息 + 代碼,不外洩原始錯誤。
  const errorBox = form.querySelector<HTMLElement>('.submit-error')!;
  const errorText = form.querySelector<HTMLElement>('.submit-error-text')!;
  const retryBtn = form.querySelector<HTMLButtonElement>('.retry-btn')!;
  const honeypot = form.querySelector<HTMLInputElement>('[name="website"]')!;
  const phoneInput = form.querySelector<HTMLInputElement>('[name="phone"]')!;
  const noteInput = form.querySelector<HTMLTextAreaElement>('[name="note"]')!;
  const CJK = /[㐀-鿿豈-﫿]/;
  const openedAt = Date.now();
  let submitting = false;

  // 先讓 role="alert" 進入無障礙樹,再寫入內容,螢幕閱讀器才會播報
  const showError = (msg: string) => {
    errorBox.hidden = false;
    errorText.textContent = msg;
  };

  const doSubmit = async () => {
    if (submitting) return;
    submitting = true;
    errorBox.hidden = true;
    submitBtn.disabled = true;
    submitBtn.classList.add('is-loading');
    try {
      const activeRole = document.querySelector<HTMLElement>('.role-btn.is-on');
      const res = await fetch(DEMO_API.endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${DEMO_API.anonKey}`,
          apikey: DEMO_API.anonKey,
        },
        body: JSON.stringify({
          role: activeRole?.dataset.role ?? 'supervisor',
          name: nameInput.value.trim(),
          org: orgInput.value.trim(),
          email: emailInput.value.trim(),
          phone: phoneInput.value.trim(),
          topics: [...document.querySelectorAll<HTMLElement>('.topic-chip.is-on')].map((b) => b.dataset.topic ?? ''),
          note: noteInput.value.trim(),
          website: honeypot.value,
          elapsed_ms: Date.now() - openedAt,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const serverMsg = typeof data?.error === 'string' && CJK.test(data.error) ? data.error : null;
        showError(serverMsg ?? `預約未送出，請稍後再試。（代碼 ${res.status}）`);
        return;
      }
      form.hidden = true;
      success.hidden = false;
    } catch {
      showError('網路連線不穩，請確認連線後再試一次。');
    } finally {
      submitting = false;
      submitBtn.classList.remove('is-loading');
      refresh();
    }
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!ready()) return;
    doSubmit();
  });
  retryBtn.addEventListener('click', () => {
    if (ready()) doSubmit();
  });

  // 原型 reset:清 name/org/email 與已選議題,身分保留
  againBtn.addEventListener('click', () => {
    [nameInput, orgInput, emailInput].forEach((el) => (el.value = ''));
    topicBtns.forEach((b) => {
      b.classList.remove('is-on');
      b.setAttribute('aria-pressed', 'false');
    });
    refresh();
    success.hidden = true;
    form.hidden = false;
  });

  refresh();
</script>
</Base>

<style>
  .demo-main { background: var(--g-ground); }

  .demo-grid {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 44px;
    align-items: start;
  }

  /* ---------- 表單大卡 ---------- */

  .form-card {
    background: #fff;
    border: 1px solid var(--g-line);
    border-radius: 28px;
    box-shadow: var(--shadow-sm);
    padding: 40px 44px 36px;
  }

  .form-title { font-size: 32px; line-height: 1.3; }

  .form-lede {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--color-neutral-800);
  }

  .group-label {
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .role-group { margin-top: 30px; }
  .topics-group { margin-top: 24px; }

  /* 身分三選一 */
  .role-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .role-btn {
    text-align: left;
    background: #fff;
    border: 1px solid var(--color-divider);
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    font-family: var(--font-body);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 7px;
    position: relative;
  }
  .role-btn:not(.is-on):hover { background: var(--color-neutral-200); }
  /* 選取態:2px 主色框 + 淺藍底;padding 減 1px 抵銷邊框增量,尺寸不跳動 */
  .role-btn.is-on {
    background: var(--color-accent-100);
    border: 2px solid var(--color-accent);
    padding: 15px;
  }
  .role-icon { font-size: 24px; color: var(--color-neutral-700); }
  .role-btn.is-on .role-icon {
    color: var(--color-accent);
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .role-label { font-size: 14.5px; font-weight: 500; }
  .role-desc { font-size: 11.5px; line-height: 1.7; color: var(--color-neutral-700); }
  .role-check {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 19px;
    color: var(--color-accent);
    display: none;
  }
  .role-btn.is-on .role-check { display: inline-block; }

  /* 浮動標籤輸入框 */
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 26px;
  }
  .fld-wrap { display: block; position: relative; }
  .fld {
    width: 100%;
    box-sizing: border-box;
    height: 52px;
    padding: 0 16px;
    font-size: 15px;
    border-radius: 8px;
    border: 1px solid var(--color-divider);
    background: #fff;
    color: var(--color-text);
    font-family: var(--font-body);
    outline: none;
  }
  .fld:focus { border-color: var(--color-accent); }
  /* README a11y:focus-visible 一律 2px 主色外框(outline:none 只擋滑鼠 focus) */
  .fld:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  textarea.fld {
    height: auto;
    padding: 14px 16px;
    line-height: 1.7;
    resize: vertical;
  }
  .fld-label {
    position: absolute;
    top: -8px;
    left: 10px;
    padding: 0 6px;
    background: #fff;
    font-size: 11.5px;
    color: var(--color-neutral-700);
  }
  .note-wrap { margin-top: 26px; }

  /* 議題 chip(可多選) */
  .topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .topic-chip {
    height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--color-divider);
    color: var(--color-neutral-800);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .topic-chip:not(.is-on):hover { background: var(--color-neutral-200); }
  .topic-chip.is-on {
    background: var(--color-accent-100);
    border-color: var(--color-accent);
    color: var(--c-info-text);
  }
  .topic-check { font-size: 15px; display: none; }
  .topic-chip.is-on .topic-check { display: inline-block; }

  .privacy {
    margin-top: 22px;
    padding: 14px 16px;
    background: var(--g-ground);
    border-radius: 8px;
    display: flex;
    gap: 11px;
    align-items: flex-start;
  }
  .privacy-icon { font-size: 18px; color: var(--color-neutral-700); flex: none; }
  .privacy-text { font-size: 12px; line-height: 1.8; color: var(--color-neutral-700); }

  .submit-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 26px;
  }
  .submit-btn {
    height: 46px;
    padding: 0 28px;
    border-radius: 100px;
    background: var(--color-accent);
    border: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .submit-btn:not([disabled]):hover { background: var(--color-accent-700); }
  .submit-btn[disabled] {
    background: #bdc1c6;
    cursor: not-allowed;
  }
  .submit-icon { font-size: 19px; }
  .submit-hint { font-size: 12.5px; color: var(--color-neutral-700); }

  /* 送出中:progress_activity 0.9s linear 旋轉,箭頭隱藏 */
  .submit-spin { display: none; font-size: 19px; }
  .submit-btn.is-loading .submit-spin {
    display: inline-block;
    animation: demo-spin .9s linear infinite;
  }
  .submit-btn.is-loading .submit-icon { display: none; }
  @keyframes demo-spin {
    to { transform: rotate(360deg); }
  }

  /* 失敗狀態:#fce8e6 底 + error 圖示 + 重試鈕 */
  /* hidden 屬性必須壓過 display:flex,否則錯誤條會常駐(2026-08-25 線上事故) */
  .submit-error[hidden] { display: none; }
  .submit-error {
    margin-top: 22px;
    padding: 12px 16px;
    background: var(--c-danger-tint);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .submit-error-icon { font-size: 18px; color: var(--c-danger-text); flex: none; }
  .submit-error-text {
    font-size: 13px;
    line-height: 1.7;
    color: var(--c-danger-text);
    flex: 1;
  }
  .retry-btn {
    height: 32px;
    padding: 0 16px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid var(--color-divider);
    color: var(--c-danger-text);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    flex: none;
  }
  .retry-btn:hover { background: var(--c-danger-tint); }
  @media (max-width: 768px) {
    .retry-btn { min-height: 44px; }
  }

  /* 蜜罐:視覺與輔助技術都看不到 */
  .hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* 送出後的確認畫面 */
  .form-success {
    padding: 24px 0 12px;
    text-align: center;
  }
  .success-icon { font-size: 44px; color: var(--c-ok); }
  .success-title { font-size: 28px; margin-top: 16px; }
  .success-desc {
    margin: 14px auto 0;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--color-neutral-800);
    max-width: 440px;
  }
  .again-btn {
    margin-top: 26px;
    height: 40px;
    padding: 0 22px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid var(--color-divider);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
