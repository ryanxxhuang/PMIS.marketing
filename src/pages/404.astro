---
// 404:Astro 靜態輸出會產生 dist/404.html,GitHub Pages 會自動拿它當找不到頁面的回應。
//
// Header 傳 page="404":沒有任何導覽連結會被標成當前頁(404 本來就不是導覽上的頁)。
// 版面沿用 global.css:.section(上下留白)+ .wrap(1180px／左右 24px)
// + .btn / .btn-primary / .btn-link,這裡只補置中與最小高度。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="找不到頁面 — GovAgent"
  description="這個網址可能已經變更或輸入有誤。回 GovAgent 首頁，或直接預約一次線上示範。"
  noindex
>
  <Header page="404" />
  <main id="main" tabindex="-1">
    <section class="section nf">
      <div class="wrap nf-inner">
        <div class="num nf-code">404</div>
        <h1 class="nf-h1">找不到這個頁面</h1>
        <p class="nf-desc">
          這個網址可能已經變更、輸入有誤，或頁面已經下架；你可以回首頁重新找起，或直接跟我們約一次線上示範。
        </p>
        <div class="nf-actions">
          <a class="btn btn-primary" href="/">回首頁</a>
          <a class="btn-link" href="/demo/">預約線上示範<Icon name="chevron_right" size={16} /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .nf-inner {
    width: 100%;
    text-align: center;
  }

  /* 「404」用 display 級(54),字色 --blue-text(6.95),不用填色藍當字 */
  .nf-code {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 600;
    color: var(--blue-text);
  }

  .nf-h1 {
    margin-top: 16px;
    font-size: var(--text-title1);
    line-height: var(--text-title1--line-height);
    letter-spacing: var(--text-title1--letter-spacing);
  }

  /* --text-2 對 --surface 7.31 */
  .nf-desc {
    margin: 16px auto 0;
    max-width: 520px;
    font-size: var(--text-title3);
    letter-spacing: var(--text-title3--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }
</style>
