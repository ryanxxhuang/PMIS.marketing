---
// AI 邊界與資安。視覺照 handoff「AI 邊界與資安.dc.html」第 77–264 行 1:1 重建，
// inline style 改寫成下方 scoped class，值未做任何調整；文案逐字沿用。
//
// 這頁是給機關拿去簽辦用的：工具白名單、測試數字與 AI 功能開關的文字與數值不得改動。
//
// 外框用 global.css 的 .wrap(1180px／左右 24px)、.kicker、.btn、.num、Icon;
// 頁首與深底 CTA 自己出血、不套 .wrap。段落節奏(.sec)與 global 的 .section 同一組 clamp,
// 只是這頁的段落在 .wrap 之內,所以自己寫一份。
//
// 頁首置中(Apple.com 內頁),眉標吃 global 的 .kicker。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';

// 工具白名單：全站最重要的一張圖，兩欄逐字對照，不得增刪
const canDo = [
  '查詢本案的工項、日誌、查驗、估驗與文件',
  '彙整資料，指出差異與可能的風險',
  '從契約與規範抽出履約要求，附條號、頁碼與信賴度',
  '草擬施工日誌、月報、查驗表與審查意見',
  '複述由引擎算出的金額與期限',
];

const cannotDo = [
  '核定估驗計價或請款',
  '判定查驗合格或不合格',
  '結案缺失、RFI 或送審',
  '辦理驗收或凍結專案',
  '自行乘除金額、自行編造契約或法規條號',
];

// 第三步（AI 產草稿）是唯一的 AI 面板色：--ai-tint 底、--ai-text 字
const steps = [
  { num: '01', title: '工具取資料', desc: '只能取本案、本角色可見的資料', ai: false },
  { num: '02', title: '引擎算數字', desc: '金額、期限與合格判定由程式或 Trigger 執行', ai: false },
  { num: '03', title: 'AI 產草稿', desc: '附來源段落與信賴度，寫入待覆核清單', ai: true },
  { num: '04', title: '人覆核', desc: '接受、修改或拒絕，逐欄比對差異', ai: false },
  { num: '05', title: '留痕', desc: '由資料庫寫入稽核軌跡，不可竄改', ai: false },
];

const guards = [
  {
    title: '資料列級安全性',
    desc: '多租戶架構下，每個查詢都在資料庫層被限制在使用者所屬的專案與角色範圍。跳過介面直接呼叫 API 也拿不到別案的資料。',
  },
  {
    title: '狀態轉移 Guard',
    desc: '估驗、送審、缺失與驗收的狀態只能依契約流程前進。缺失未複驗合格，就不能結案；估驗未核定，就不能請款。',
  },
  {
    title: 'Audit Trigger',
    desc: '稽核事件由資料庫 Trigger 寫入，應用程式無法略過。供審計、政風與監察調閱。',
  },
];

// 測試數字為 2026-08-25 基線（實測：761 unit / 32 pgTAP / 38 e2e），
// 與 landing SecurityAudit.astro 同源。只能依實測結果更新，不得為了好看而灌水。
const tests = [
  { num: '761', desc: '單元測試項，涵蓋計價、期限與罰則等確定性引擎' },
  { num: '32', desc: '組資料庫測試，專門驗證資料列級安全性與狀態轉移' },
  { num: '38', desc: '端到端流程測試，含三角色實際後端冒煙測試' },
  { num: '16', desc: '個 AI 功能，每一個都能單獨開關與計量' },
];

const dataCards = [
  {
    icon: 'shield',
    title: '資通系統防護基準',
    desc: '依普通級設計。存取控制、加密傳輸、弱點掃描與修補紀錄可提供給機關資安審查。',
  },
  {
    icon: 'location_on',
    title: '個資境內存放',
    desc: '個人資料存放於境內，未境外傳輸。字型與圖示可自行託管，適用禁止外連 CDN 的機關環境。',
  },
  {
    icon: 'history',
    title: '稽核軌跡留存',
    desc: '登入與操作留存稽核軌跡，保存期間可依機關規定與契約約定調整。',
  },
];

// AI 功能開關（節錄）：狀態色票用五語意狀態色，顏色＋文字並存
const features = [
  {
    name: '契約文件解析 · 抽出履約要求',
    sub: '結果需人核定後才具權威性',
    state: 'ok' as const,
    stateLabel: '已啟用',
    count: '本月 214 次',
  },
  {
    name: '施工日誌草稿',
    sub: '依前日進度、照片與氣象觀測擬稿',
    state: 'ok' as const,
    stateLabel: '已啟用',
    count: '本月 96 次',
  },
  {
    name: '現場照片異常標記',
    sub: '僅限已核定的量測型規範項目',
    state: 'warn' as const,
    stateLabel: '限定啟用',
    count: '本月 38 次',
  },
  {
    name: '跨案彙整問答',
    sub: '本機關尚未開啟',
    state: 'off' as const,
    stateLabel: '停用',
    count: '—',
  },
];
---

<Base
  title="AI 邊界與資安 — GovAgent"
  description="AI 能做什麼、不能做什麼，寫得出來：工具白名單、資料列級安全性與稽核軌跡留存，依資通系統防護基準設計，個資境內存放。這一頁是為了讓你能拿去簽辦。"
>
  <Header page="security" />
  <main id="main" tabindex="-1">
    <section class="page-head">
      <div class="page-head-inner">
        <div class="kicker">AI 邊界與資安</div>
        <h1 class="page-h1">AI 能做什麼、不能做什麼，寫得出來</h1>
        <p class="page-desc">
          這一頁是為了讓你能拿去簽辦。機關要問的三件事——AI 會不會自己決定、資料在哪裡、出事查得到嗎——下面逐一回答。
        </p>
      </div>
    </section>

    <div class="wrap">
      <section class="sec">
        <h2 class="sec-h2">Agent 的工具白名單</h2>
        <p class="sec-desc">
          限制不是寫在提示詞裡，是寫在工具清單裡。核定、判定、結案、驗收、凍結這些動作，Agent 的工具箱裡根本沒有——就算它想做也叫不到。
        </p>

        <div class="tools">
          <div class="tool-card">
            <div class="tool-head tool-head--ok">
              <Icon name="check_circle" size={20} class="tool-icon tool-icon--ok" />
              <h3 class="tool-title tool-title--ok">Agent 可以做</h3>
            </div>
            <div class="tool-list">
              {canDo.map((item) => <div class="tool-row">{item}</div>)}
            </div>
          </div>

          <div class="tool-card">
            <div class="tool-head tool-head--deny">
              <Icon name="block" size={20} class="tool-icon tool-icon--deny" />
              <h3 class="tool-title tool-title--deny">Agent 沒有這些工具</h3>
            </div>
            <div class="tool-list">
              {cannotDo.map((item) => <div class="tool-row">{item}</div>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <h2 class="sec-h2">草稿到核定，中間一定有人</h2>
        <p class="sec-desc">
          AI 的產出一律進入待覆核清單，記下角色、種類、目標、理由與佐證，由人接受或拒絕。人的每一次覆核也記下來，成為可供調閱的稽核軌跡。
        </p>

        <div class="steps">
          {
            steps.map((step) => (
              <div class={step.ai ? 'step step--ai' : 'step'}>
                <div class="num step-num">{step.num}</div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sec">
        <div class="guards-split">
          <div>
            <h2 class="sec-h2">權限的邊界在資料庫</h2>
            <p class="sec-desc">前端隱藏按鈕不是安全機制。真正的邊界有三層，全部在伺服器端：</p>

            <div class="guard-list">
              {
                guards.map((guard) => (
                  <div class="guard">
                    <h3 class="guard-title">{guard.title}</h3>
                    <p class="guard-desc">{guard.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <h2 class="sec-h2">可以查證的部分</h2>
            <p class="sec-desc">這些邊界不是宣稱，是有測試在守的。每次改動都要全部通過才能上線。</p>

            <div class="tests">
              {
                tests.map((test) => (
                  <div class="test-card">
                    <div class="num test-num">{test.num}</div>
                    <div class="test-desc">{test.desc}</div>
                  </div>
                ))
              }
            </div>
            <p class="tests-foot">數字為 2026-08-25 基線，隨版本更新。示範時可以現場跑給你看。</p>
          </div>
        </div>
      </section>

      <section class="sec">
        <h2 class="sec-h2">資料在哪裡、留多久</h2>

        <div class="data-grid">
          {
            dataCards.map((card) => (
              <div class="data-card">
                <Icon name={card.icon} size={24} class="data-icon" />
                <h3 class="data-title">{card.title}</h3>
                <p class="data-desc">{card.desc}</p>
              </div>
            ))
          }
        </div>

        <div class="data-note">
          <Icon name="description" size={20} class="data-note-icon" />
          <p class="data-note-text">
            資安政策、符合性說明與弱點掃描證據可依機關要求提供，用於簽辦與採購文件。示範時一併帶給你。
          </p>
        </div>
      </section>

      <section class="sec sec--last">
        <h2 class="sec-h2">AI 功能可以逐一關掉</h2>
        <p class="sec-desc">
          每個 AI 功能都是獨立模組，閘門在伺服器端。機關可以只開文件解析、不開對話；也可以在特定期間全部關閉，系統其餘功能照常運作。每次呼叫都記錄功能、使用者、專案與成本。
        </p>

        <div class="toggle-card">
          <div class="toggle-head">
            <h3 class="toggle-head-title">AI 功能開關（節錄）</h3>
            <span class="toggle-head-meta">平台管理 · 僅平台管理員可見</span>
          </div>
          {
            features.map((feature) => (
              <div class="toggle-row">
                <div>
                  <div class="toggle-name">{feature.name}</div>
                  <div class="toggle-sub">{feature.sub}</div>
                </div>
                <span class={`toggle-chip toggle-chip--${feature.state}`}>{feature.stateLabel}</span>
                <span class="num toggle-count">{feature.count}</span>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="cta">
      <div class="cta-inner">
        <div>
          <h2 class="cta-h2">要拿去簽辦的資料，我們直接給</h2>
          <p class="cta-desc">
            示範時一併帶上資安符合性說明、AI 功能清單與稽核軌跡範例，讓你不用另外整理。
          </p>
        </div>
        <a class="btn cta-btn" href="/demo/">
          {SITE.ctaLabel}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* 文字色對 --surface 的實算:--text 16.83、--text-2 7.31、--text-3 5.54、--blue-text 6.95;
     對 --bg(灰磚):--text-2 6.71、--text-3 5.09、--blue-text 6.38 */

  /* ---------- 頁首:置中(Apple.com 內頁),吃 global 的 .kicker ---------- */

  .page-head {
    padding: clamp(48px, 6vw, 72px) 24px 0;
  }

  .page-head-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .page-h1 {
    font-size: clamp(var(--text-title1), 5vw, var(--text-headline));
    line-height: 1.15;
    letter-spacing: var(--text-headline--letter-spacing);
    margin-top: 12px;
    text-wrap: balance;
  }

  .page-desc {
    margin: 16px auto 0;
    max-width: 660px;
    font-size: var(--text-title3);
    letter-spacing: var(--text-title3--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  /* ---------- 段落節奏:大留白,不畫線(同 global .section) ---------- */

  .sec { padding: clamp(44px, 5vw, 72px) 0; }

  /* 最後一段:下面接深底 CTA,底部留白再多一點 */
  .sec--last { padding-bottom: clamp(56px, 6vw, 88px); }

  .sec-h2 {
    font-size: clamp(var(--text-title1), 3.6vw, var(--text-headline));
    line-height: 1.15;
    letter-spacing: var(--text-headline--letter-spacing);
  }

  .sec-desc {
    margin: 14px 0 0;
    font-size: var(--text-title3);
    letter-spacing: var(--text-title3--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
    max-width: 700px;
  }

  /* ---------- 1. Agent 的工具白名單 ---------- */

  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }
  @media (max-width: 900px) {
    .tools {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* 兩張清單卡是「產品畫面」:白面 + 半像素描邊 + 輕影 */
  .tool-card {
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    background: var(--surface);
    overflow: hidden;
  }

  .tool-head {
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tool-head--ok { background: var(--green-tint); }
  .tool-head--deny { background: var(--red-tint); }

  .tool-icon--ok { color: var(--success); }   /* 圖形,對 --green-tint 也 > 3:1 */
  .tool-icon--deny { color: var(--danger); }  /* 圖形 4.71 對 --red-tint */

  .tool-title {
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .tool-title--ok { color: var(--green-text); }   /* 5.90 對 --green-tint */
  .tool-title--deny { color: var(--red-text); }   /* 6.28 對 --red-tint */

  .tool-list { padding: 6px 0; }

  .tool-row {
    padding: 12px 18px;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
  }
  .tool-row:not(:last-child) {
    border-bottom: 1px solid var(--border-2);
  }

  /* ---------- 2. 草稿到核定五步 ---------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 36px;
    align-items: stretch;
  }
  @media (max-width: 1080px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  /* 灰磚;第三步是唯一的 AI 面板色 */
  .step {
    border-radius: 16px;
    padding: 18px;
    background: var(--bg);
  }
  .step--ai { background: var(--ai-tint); }

  .step-num {
    font-family: var(--font-display);
    font-size: var(--text-footnote);
    line-height: var(--text-footnote--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
    color: var(--blue-text);
    font-weight: 600;
  }
  .step--ai .step-num { color: var(--ai-text); } /* 6.87 對 --ai-tint */

  .step-title {
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-family: var(--font-display);
    font-weight: 600;
    margin-top: 8px;
  }

  .step-desc {
    margin: 6px 0 0;
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }
  .step--ai .step-desc { color: var(--ai-text); }

  /* ---------- 3. 權限的邊界在資料庫 ／ 可以查證的部分 ---------- */

  .guards-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .guards-split {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }

  .guard-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
  }

  /* 三層邊界:純文字階層(標題 title3 + 說明),不畫左側裝飾線 */
  .guard-title {
    font-size: var(--text-title3);
    line-height: var(--text-title3--line-height);
    letter-spacing: var(--text-title3--letter-spacing);
  }

  .guard-desc {
    margin: 6px 0 0;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .tests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 28px;
  }

  /* 灰磚 */
  .test-card {
    border-radius: 16px;
    padding: 20px;
    background: var(--bg);
  }

  /* 數字吃 .num 的 tabular-nums;headline(40)級的統計數字 */
  .test-num {
    font-family: var(--font-display);
    font-size: var(--text-headline);
    line-height: var(--text-headline--line-height);
    letter-spacing: var(--text-headline--letter-spacing);
    font-weight: 600;
  }

  .test-desc {
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
    margin-top: 6px;
  }

  .tests-foot {
    margin-top: 16px;
    font-size: var(--text-footnote);
    letter-spacing: var(--text-footnote--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-3);
  }

  /* ---------- 4. 資料在哪裡、留多久 ---------- */

  .data-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  @media (max-width: 900px) {
    .data-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  /* 灰磚 */
  .data-card {
    border-radius: 16px;
    padding: 24px 22px 22px;
    background: var(--bg);
  }

  .data-icon { color: var(--success); } /* 圖形 6.05 對 --bg */

  .data-title {
    font-size: var(--text-title3);
    line-height: var(--text-title3--line-height);
    letter-spacing: var(--text-title3--letter-spacing);
    margin-top: 14px;
  }

  .data-desc {
    margin: 8px 0 0;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .data-note {
    margin-top: 20px;
    padding: 18px 20px;
    border-radius: 16px;
    background: var(--bg);
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .data-note-icon {
    color: var(--text-3);
    flex: none;
    margin-top: 2px;
  }

  .data-note-text {
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  /* ---------- 5. AI 功能開關表(產品畫面:白面 + 描邊 + 輕影) ---------- */

  .toggle-card {
    margin-top: 32px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
