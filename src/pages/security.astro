---
// AI 邊界與資安。視覺照 handoff「AI 邊界與資安.dc.html」第 77–264 行 1:1 重建，
// inline style 改寫成下方 scoped class，值未做任何調整；文案逐字沿用。
//
// 這頁是給機關拿去簽辦用的：工具白名單、測試數字與 AI 功能開關的文字與數值不得改動。
//
// 外框用 global.css 的 .wrap（1180px／左右 24px）、.num、.msy；
// 頁首與深底 CTA 自己出血、不套 .wrap。段落節奏不套 .section
// （原型是固定 64px，不是 landing 的 clamp(56px,8vw,88px)）。
//
// 頁首 kicker 是純文字，不用 global 的 .kicker——那個帶 24px 主色橫線。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

// 工具白名單：全站最重要的一張圖，兩欄逐字對照，不得增刪
const canDo = [
  '查詢本案的工項、日誌、查驗、估驗與文件',
  '彙整資料，指出差異與可能的風險',
  '從契約與規範抽出履約要求，附條號、頁碼與信賴度',
  '草擬施工日誌、月報、查驗表與審查意見',
  '複述由引擎算出的金額與期限',
];

const cannotDo = [
  '核定估驗計價或請款',
  '判定查驗合格或不合格',
  '結案缺失、RFI 或送審',
  '辦理驗收或凍結專案',
  '自行乘除金額、自行編造契約或法規條號',
];

// 第三步（AI 產草稿）是唯一的 AI 面板色：--ai-tint 底、--ai-text 字
const steps = [
  { num: '01', title: '工具取資料', desc: '只能取本案、本角色可見的資料', ai: false },
  { num: '02', title: '引擎算數字', desc: '金額、期限與合格判定由程式或 Trigger 執行', ai: false },
  { num: '03', title: 'AI 產草稿', desc: '附來源段落與信賴度，寫入待覆核清單', ai: true },
  { num: '04', title: '人覆核', desc: '接受、修改或拒絕，逐欄比對差異', ai: false },
  { num: '05', title: '留痕', desc: '由資料庫寫入稽核軌跡，不可竄改', ai: false },
];

const guards = [
  {
    title: '資料列級安全性',
    desc: '多租戶架構下，每個查詢都在資料庫層被限制在使用者所屬的專案與角色範圍。跳過介面直接呼叫 API 也拿不到別案的資料。',
  },
  {
    title: '狀態轉移 Guard',
    desc: '估驗、送審、缺失與驗收的狀態只能依契約流程前進。缺失未複驗合格，就不能結案；估驗未核定，就不能請款。',
  },
  {
    title: 'Audit Trigger',
    desc: '稽核事件由資料庫 Trigger 寫入，應用程式無法略過。供審計、政風與監察調閱。',
  },
];

// 測試數字為 2026-08 基線，與 landing SecurityAudit.astro 同源，不得改動
const tests = [
  { num: '530', desc: '單元測試項，涵蓋計價、期限與罰則等確定性引擎' },
  { num: '23', desc: '組資料庫測試，專門驗證資料列級安全性與狀態轉移' },
  { num: '19', desc: '端到端流程測試，含三角色實際後端冒煙測試' },
  { num: '16', desc: '個 AI 功能，每一個都能單獨開關與計量' },
];

const dataCards = [
  {
    icon: 'shield',
    title: '資通系統防護基準',
    desc: '依普通級設計。存取控制、加密傳輸、弱點掃描與修補紀錄可提供給機關資安審查。',
  },
  {
    icon: 'location_on',
    title: '個資境內存放',
    desc: '個人資料存放於境內，未境外傳輸。字型與圖示可自行託管，適用禁止外連 CDN 的機關環境。',
  },
  {
    icon: 'history',
    title: '稽核軌跡留存',
    desc: '登入與操作留存稽核軌跡，保存期間可依機關規定與契約約定調整。',
  },
];

// AI 功能開關（節錄）：狀態色票用五語意狀態色，顏色＋文字並存
const features = [
  {
    name: '契約文件解析 · 抽出履約要求',
    sub: '結果需人核定後才具權威性',
    state: 'ok' as const,
    stateLabel: '已啟用',
    count: '本月 214 次',
  },
  {
    name: '施工日誌草稿',
    sub: '依前日進度、照片與氣象觀測擬稿',
    state: 'ok' as const,
    stateLabel: '已啟用',
    count: '本月 96 次',
  },
  {
    name: '現場照片異常標記',
    sub: '僅限已核定的量測型規範項目',
    state: 'warn' as const,
    stateLabel: '限定啟用',
    count: '本月 38 次',
  },
  {
    name: '跨案彙整問答',
    sub: '本機關尚未開啟',
    state: 'off' as const,
    stateLabel: '停用',
    count: '—',
  },
];
---

<Base
  title="AI 邊界與資安 — PMIS.ai"
  description="AI 能做什麼、不能做什麼，寫得出來。這一頁是為了讓你能拿去簽辦。"
>
  <Header page="security" />
  <main>
    <section class="page-head">
      <div class="page-head-inner">
        <div class="page-kicker">AI 邊界與資安</div>
        <h1 class="page-h1">AI 能做什麼、不能做什麼，寫得出來</h1>
        <p class="page-desc">
          這一頁是為了讓你能拿去簽辦。機關要問的三件事——AI 會不會自己決定、資料在哪裡、出事查得到嗎——下面逐一回答。
        </p>
      </div>
    </section>

    <div class="wrap">
      <section class="sec">
        <h2 class="sec-h2">Agent 的工具白名單</h2>
        <p class="sec-desc">
          限制不是寫在提示詞裡，是寫在工具清單裡。核定、判定、結案、驗收、凍結這些動作，Agent 的工具箱裡根本沒有——就算它想做也叫不到。
        </p>

        <div class="tools">
          <div class="tool-card">
            <div class="tool-head tool-head--ok">
              <span class="msy tool-icon tool-icon--ok" aria-hidden="true">check_circle</span>
              <h3 class="tool-title tool-title--ok">Agent 可以做</h3>
            </div>
            <div class="tool-list">
              {canDo.map((item) => <div class="tool-row">{item}</div>)}
            </div>
          </div>

          <div class="tool-card">
            <div class="tool-head tool-head--deny">
              <span class="msy tool-icon tool-icon--deny" aria-hidden="true">block</span>
              <h3 class="tool-title tool-title--deny">Agent 沒有這些工具</h3>
            </div>
            <div class="tool-list">
              {cannotDo.map((item) => <div class="tool-row">{item}</div>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <h2 class="sec-h2">草稿到核定，中間一定有人</h2>
        <p class="sec-desc">
          AI 的產出一律進入待覆核清單，記下角色、種類、目標、理由與佐證，由人接受或拒絕。人的每一次覆核也記下來，於是你有一個能對外講的指標：AI 建議採納率。
        </p>

        <div class="steps">
          {
            steps.map((step) => (
              <div class={step.ai ? 'step step--ai' : 'step'}>
                <div class="num step-num">{step.num}</div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sec">
        <div class="guards-split">
          <div>
            <h2 class="sec-h2">權限的邊界在資料庫</h2>
            <p class="sec-desc">前端隱藏按鈕不是安全機制。真正的邊界有三層，全部在伺服器端：</p>

            <div class="guard-list">
              {
                guards.map((guard) => (
                  <div class="guard">
                    <h3 class="guard-title">{guard.title}</h3>
                    <p class="guard-desc">{guard.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <h2 class="sec-h2">可以查證的部分</h2>
            <p class="sec-desc">這些邊界不是宣稱，是有測試在守的。每次改動都要全部通過才能上線。</p>

            <div class="tests">
              {
                tests.map((test) => (
                  <div class="test-card">
                    <div class="num test-num">{test.num}</div>
                    <div class="test-desc">{test.desc}</div>
                  </div>
                ))
              }
            </div>
            <p class="tests-foot">數字為 2026-08 基線，隨版本更新。示範時可以現場跑給你看。</p>
          </div>
        </div>
      </section>

      <section class="sec">
        <h2 class="sec-h2">資料在哪裡、留多久</h2>

        <div class="data-grid">
          {
            dataCards.map((card) => (
              <div class="data-card">
                <span class="msy data-icon" aria-hidden="true">{card.icon}</span>
                <h3 class="data-title">{card.title}</h3>
                <p class="data-desc">{card.desc}</p>
              </div>
            ))
          }
        </div>

        <div class="data-note">
          <span class="msy data-note-icon" aria-hidden="true">description</span>
          <p class="data-note-text">
            資安政策、符合性說明與弱點掃描證據可依機關要求提供，用於簽辦與採購文件。示範時一併帶給你。
          </p>
        </div>
      </section>

      <section class="sec sec--last">
        <h2 class="sec-h2">AI 功能可以逐一關掉</h2>
        <p class="sec-desc">
          每個 AI 功能都是獨立模組，閘門在伺服器端。機關可以只開文件解析、不開對話；也可以在特定期間全部關閉，系統其餘功能照常運作。每次呼叫都記錄功能、使用者、專案與成本。
        </p>

        <div class="toggle-card">
          <div class="toggle-head">
            <h3 class="toggle-head-title">AI 功能開關（節錄）</h3>
            <span class="toggle-head-meta">平台管理 · 僅平台管理員可見</span>
          </div>
          {
            features.map((feature) => (
              <div class="toggle-row">
                <div>
                  <div class="toggle-name">{feature.name}</div>
                  <div class="toggle-sub">{feature.sub}</div>
                </div>
                <span class={`toggle-chip toggle-chip--${feature.state}`}>{feature.stateLabel}</span>
                <span class="num toggle-count">{feature.count}</span>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="cta">
      <div class="cta-inner">
        <div>
          <h2 class="cta-h2">要拿去簽辦的資料，我們直接給</h2>
          <p class="cta-desc">
            示範時一併帶上資安符合性說明、AI 功能清單與稽核軌跡範例，讓你不用另外整理。
          </p>
        </div>
        <a class="cta-btn" href="/demo">
          {SITE.ctaLabel}<span class="msy cta-icon" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* ---------- 頁首 ---------- */

  .page-head {
    padding: 64px 24px 48px;
    border-bottom: 1px solid var(--g-line);
    background: linear-gradient(180deg, #fff, var(--g-ground));
  }

  .page-head-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  /* 純文字 kicker，沒有 global .kicker 的橫線 */
  .page-kicker {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-accent-700);
  }

  /* 原型是 44px + 720px 以下 32px；這裡改成同區間的 clamp */
  .page-h1 {
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.22;
    margin-top: 14px;
  }

  .page-desc {
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 1.9;
    color: var(--color-neutral-800);
  }

  /* ---------- 段落節奏（原型固定 64px，非 landing 的 clamp） ---------- */

  .sec {
    padding: 64px 0;
    border-bottom: 1px solid var(--g-line);
  }

  /* 最後一段：底部多留 24px，且沒有下緣線（下面接深底 CTA） */
  .sec--last {
    padding: 64px 0 88px;
    border-bottom: 0;
  }

  .sec-h2 {
    font-size: 30px;
  }

  .sec-desc {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.9;
    color: var(--color-neutral-800);
    max-width: 700px;
  }

  @media (max-width: 720px) {
    .sec-h2 {
      font-size: 24px;
    }
  }

  /* ---------- 1. Agent 的工具白名單 ---------- */

  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }
  @media (max-width: 900px) {
    .tools {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .tool-card {
    border: 1px solid var(--g-line);
    border-radius: 12px;
    overflow: hidden;
  }

  .tool-head {
    padding: 13px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tool-head--ok {
    background: var(--c-ok-tint);
  }
  .tool-head--deny {
    background: var(--c-danger-tint);
  }

  .tool-icon {
    font-size: 20px;
  }
  .tool-icon--ok {
    color: var(--c-ok);
  }
  /* 原型寫字面值 #b3261e（＝ --c-danger），圖示與 --c-danger-text 標題成對 */
  .tool-icon--deny {
    color: #b3261e;
  }

  .tool-title {
    font-size: 15px;
    font-family: var(--font-heading);
    font-weight: 500;
  }
  /* 綠卡標題是比 --c-ok 再深一階的字面值，不進 token */
  .tool-title--ok {
    color: #0f5223;
  }
  .tool-title--deny {
    color: var(--c-danger-text);
  }

  .tool-list {
    padding: 6px 0;
  }

  .tool-row {
    padding: 11px 18px;
    font-size: 13.5px;
    line-height: 1.7;
  }
  .tool-row:not(:last-child) {
    border-bottom: 1px solid var(--g-line);
  }

  /* ---------- 2. 草稿到核定五步 ---------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 36px;
    align-items: stretch;
  }
  @media (max-width: 1080px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  .step {
    border: 1px solid var(--g-line);
    border-radius: 12px;
    padding: 18px;
    background: var(--g-ground);
  }
  /* 第三步是唯一的 AI 面板色 */
  .step--ai {
    background: var(--ai-tint);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 12.5px;
    color: var(--color-accent-700);
    font-weight: 500;
  }
  .step--ai .step-num {
    color: var(--ai-text);
  }

  .step-title {
    font-size: 14.5px;
    font-family: var(--font-heading);
    font-weight: 500;
    margin-top: 8px;
  }

  .step-desc {
    margin: 6px 0 0;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--color-neutral-700);
  }
  .step--ai .step-desc {
    color: var(--ai-text);
  }

  /* ---------- 3. 權限的邊界在資料庫 ／ 可以查證的部分 ---------- */

  .guards-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .guards-split {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .guard-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
  }

  .guard {
    border-left: 2px solid var(--color-accent);
    padding-left: 18px;
  }

  .guard-title {
    font-size: 16px;
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .guard-desc {
    margin: 8px 0 0;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--color-neutral-800);
  }

  .tests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 28px;
  }
  /* 原型的 [style*="grid-template-columns:1fr 1fr"] 規則同時吃到這四張卡 */
  @media (max-width: 900px) {
    .tests {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .test-card {
    border: 1px solid var(--g-line);
    border-radius: 12px;
    padding: 20px;
  }

  /* 數字吃 .num 的 tabular-nums */
  .test-num {
    font-family: var(--font-display);
    font-size: 30px;
    letter-spacing: -.01em;
  }

  .test-desc {
    font-size: 12.5px;
    color: var(--color-neutral-700);
    margin-top: 6px;
    line-height: 1.7;
  }

  .tests-foot {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.8;
    color: var(--color-neutral-700);
  }

  /* ---------- 4. 資料在哪裡、留多久 ---------- */

  .data-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  @media (max-width: 900px) {
    .data-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  .data-card {
    border: 1px solid var(--g-line);
    border-radius: 12px;
    padding: 22px;
    background: var(--g-ground);
  }

  .data-icon {
    font-size: 24px;
    color: var(--c-ok);
  }

  .data-title {
    font-size: 16px;
    font-family: var(--font-heading);
    font-weight: 500;
    margin-top: 12px;
  }

  .data-desc {
    margin: 9px 0 0;
    font-size: 13px;
    line-height: 1.85;
    color: var(--color-neutral-800);
  }

  .data-note {
    margin-top: 20px;
    padding: 16px 18px;
    border: 1px solid var(--g-line);
    border-radius: 12px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .data-note-icon {
    font-size: 20px;
    color: var(--color-neutral-700);
    flex: none;
  }

  .data-note-text {
    font-size: 13px;
    line-height: 1.85;
    color: var(--color-neutral-800);
  }

  /* ---------- 5. AI 功能開關表 ---------- */

  .toggle-card {
    margin-top: 32px;
    border: 1px solid var(--g-line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .toggle-head {
    padding: 13px 18px;
    border-bottom: 1px solid var(--g-line);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .toggle-head-title {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    font-family: var(--font-heading);
  }

  .toggle-head-meta {
    font-size: 11px;
    color: var(--color-neutral-600);
  }

  .toggle-row {
    padding: 13px 18px;
    display: grid;
    grid-template-columns: 1fr 130px 120px;
    gap: 16px;
    align-items: center;
  }
  .toggle-row:not(:last-child) {
    border-bottom: 1px solid var(--g-line);
  }
  /* 900px 以下收成兩欄，次數自然換到下一列 */
  @media (max-width: 900px) {
    .toggle-row {
      grid-template-columns: 1fr auto;
    }
  }

  .toggle-name {
    font-size: 13.5px;
  }

  .toggle-sub {
    font-size: 11.5px;
    color: var(--color-neutral-700);
    margin-top: 2px;
  }

  .toggle-chip {
    height: 22px;
