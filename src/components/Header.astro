---
// 共用 sticky header(Apple.com 語彙:矮、半透明毛玻璃、純文字連結、一顆藥丸 CTA)。
// 當前頁的連結換成不可點的文字,靠字重與 --text 色標示(aria-current 仍給),不做 chip 底。
// 四頁導覽一致:同一組連結 + 登入 + CTA。
// (2026-08-25:內頁原本多一個「三方協作」、預約頁原本沒有 CTA,
//  使用者反映「每換一頁按鈕都不一樣」,故統一)
import { SITE } from '../config';

// '404' 走內頁分支:landing 分支的 #founder 是同頁錨點,在 404 頁沒有對應的 id
interface Props {
  page?: 'landing' | 'features' | 'security' | 'demo' | '404';
}

const { page = 'landing' } = Astro.props;

type NavLink = { key: string; label: string; href: string };

// href 一律帶尾斜線,與 canonical / sitemap 的正規形式一致(否則每次點擊吃一個 301)
const links: NavLink[] = [
  { key: 'features', label: '功能全覽', href: '/features/' },
  { key: 'security', label: 'AI 邊界與資安', href: '/security/' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="mark"><svg width="28" height="28" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 12.4 L34.4 30.4 L13.6 30.4 Z" fill="none" stroke="var(--border)" stroke-width="3" stroke-linejoin="round"></path><circle cx="24" cy="12.4" r="5.2" fill="var(--party-contractor)"></circle><circle cx="34.4" cy="30.4" r="5.2" fill="var(--party-supervisor)"></circle><circle cx="13.6" cy="30.4" r="5.2" fill="var(--party-agency)"></circle></svg></span>
      <span class="lockup">
        <span class="name">GovAgent</span>
        <span class="tag">公共工程專案管理</span>
      </span>
    </a>
    <nav class="nav" aria-label="主導覽">
      {
        links.map((l) =>
          l.key === page ? (
            <span class="navlink is-current" aria-current="page">{l.label}</span>
          ) : (
            <a class="navlink" href={l.href}>{l.label}</a>
          )
        )
      }
      {/* 登入是對 handoff 設計的必要增補:產品搬到 app 子網域後,
          既有使用者從根網域需要回到系統的路(720px 以下由 footer 的登入承接) */}
      <a class="navlink" href={SITE.appUrl}>登入</a>
      <a class="cta" href="/demo/">{SITE.ctaLabel}</a>
    </nav>
  </div>
</header>

<style>
  /* 52px:Apple.com 是 44,但品牌鎖定是「名稱 + 一行標語」兩行,44 放不下。
     底緣髮絲線是 chrome 與內容的分界(Marketing.dc.html 的 inset 0 -1px)。 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 52px;
    /* 毛玻璃只給 chrome(規範 §4);不支援 backdrop-filter 就落回實心,無破壞 */
    background: var(--chrome-solid);
    border-bottom: 1px solid var(--border-2);
    display: flex;
    align-items: center;
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--chrome-bar);
      -webkit-backdrop-filter: var(--chrome-bar-blur);
      backdrop-filter: var(--chrome-bar-blur);
    }
  }

  .bar {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand,
  .brand:hover {
    color: var(--text);
    text-decoration: none;
  }

  /* 品牌標誌用三色本體(頂=廠商藍／右下=監造／左下=機關 = 契約三方),
     不加藍底方塊 —— 那會蓋掉三色的語意。inline 是為了吃 --party-* token,
     配色同 public/brand/pmis-mark.svg */
  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  /* 名稱 callout/semibold(Marketing.dc.html 的 15px 600);標語 caption,--text-3 對 chrome 底 5.09 */
  .name {
    font-family: var(--font-display);
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-weight: 600;
  }
  .tag {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: var(--text-caption--letter-spacing);
    color: var(--text-3);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-left: auto;
  }

  /* 純文字連結(Apple.com 導覽):body 級、--text-2(對 chrome 底 6.71),hover 轉 --text;
     當前頁用 --text + semibold 標示,不做 chip。 */
  .navlink {
    display: inline-flex;
    align-items: center;
    height: 32px;
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--text-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  a.navlink:hover {
    color: var(--text);
    text-decoration: none;
  }
  .is-current {
    color: var(--text);
    font-weight: 600;
  }

  /* 導覽列的藥丸 CTA 比內文 CTA 矮一號(Marketing.dc.html 是 26px/12px;這裡 32px/body) */
  .cta {
    height: 32px;
    padding: 0 14px;
    border-radius: 100px;
    background: var(--primary);
    color: var(--primary-fg); /* 4.70,hover 6.95 */
    display: inline-flex;
    align-items: center;
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    font-weight: 500;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .cta:hover,
  .cta:active {
    background: var(--primary-hover);
    color: var(--primary-fg);
    text-decoration: none;
  }

  /* 720px 以下:三個文字連結(含當前頁)隱藏,只留品牌與主色鈕 */
  @media (max-width: 719px) {
    .navlink { display: none; }
  }

  /* 768px 以下可點元素觸控目標 ≥ 44px;header 跟著長高到 56 */
  @media (max-width: 768px) {
    .site-header { height: 56px; }
    .cta { height: 44px; padding: 0 18px; }
  }
</style>
