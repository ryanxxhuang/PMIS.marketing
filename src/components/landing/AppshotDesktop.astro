<div class="shot">
  <div class="side">
    <div class="side-top">
      <span class="side-menu" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" set:html={GLYPH.menu} /></span>
      <svg width="24" height="24" viewBox="0 0 48 48" class="side-logo" aria-hidden="true"><path d="M24 12.4 L34.4 30.4 L13.6 30.4 Z" fill="none" stroke="#dadce0" stroke-width="3.6" stroke-linejoin="round"></path><circle cx="24" cy="12.4" r="5.8" fill="#0b57d0"></circle><circle cx="34.4" cy="30.4" r="5.8" fill="#ea4335"></circle><circle cx="13.6" cy="30.4" r="5.8" fill="#fbbc04"></circle></svg>
      {/* 兩段著色必須包在同一個 flex item 裡,否則 .side-top 的 gap 會把字拆開 */}
      <span class="side-brand">GovAgent</span>
    </div>
    <div class="side-ask"><svg class="side-ask-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.auto_awesome} />問 GovAgent</div>
    <div class="side-group">工作面</div>
    {
      navItems.map((n) => (
        <div class:list={['side-item', { 'side-item--active': n.active }]}>
          <svg class="side-item-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={(n.active && GLYPH_FILL[n.icon]) || GLYPH[n.icon]} />
          {n.label}
          {n.count && <span class:list={['num', 'side-count', { 'side-count--hot': n.active }]}>{n.count}</span>}
        </div>
      ))
    }
    <div class="side-divider"></div>
    <div class="side-mode"><svg class="side-mode-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.verified_user} />正式模式 · 稽核中</div>
  </div>

  <div class="stage">
    <div class="appbar">
      <div class="proj-chip">
        <svg class="proj-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.folder_open} />
        <span class="proj-name">○○市立圖書館新建工程</span>
        <svg class="proj-caret" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.arrow_drop_down} />
      </div>
      <div class="searchbar">
        <svg class="search-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.search} />
        <span class="search-text">問 GovAgent：工項、送審、缺失、契約……</span>
        <svg class="search-tune" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.tune} />
      </div>
      <div class="appbar-right">
        <span class="bar-btn" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" set:html={GLYPH.dark_mode} /></span>
        <span class="bar-btn" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" set:html={GLYPH.notifications} /></span>
        <span class="bar-btn" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" set:html={GLYPH.help} /></span>
        <div class="who">
          <div class="who-avatar">王</div>
          <div class="who-meta">
            <span class="who-name">王建國</span>
            <span class="who-org">○○工程顧問 · 監造工程師</span>
          </div>
        </div>
      </div>
    </div>

    <div class="page-head">
