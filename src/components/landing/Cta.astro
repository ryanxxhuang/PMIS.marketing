---
// Landing 最後一段:深底 CTA。文案逐字沿用 handoff「PMIS.ai 官網.dc.html」第 523–546 行。
// 顏色全部走 global.css 的 --dark-* token(值=產品深色模式),不寫原型的海軍藍字面值。
//
// 版面沿用 global.css:.section(上下留白)+ .wrap(1180px／左右 24px)
// + .split-wide(1.15fr 1fr、gap 56px、920px 以下收單欄)。
//
// 按鈕不用 global 的 .btn-primary:那組是亮底上的實心主色鈕,
// 深底上改用產品深色模式的 primary(--dark-blue 底 + --dark-primary-fg 深藍字,
// 不是藍底白字——白字對深色藍不過 AA,見 global.css)。
// 輔助動作是文字連結(信箱),不做描邊鈕。
//
// showPipelineNote 為 false 時整行洽談狀態不輸出(原型的 <sc-if>)。
import { SITE } from '../../config';
import Icon from '../Icon.astro';

const steps = [
  { num: '01', title: '匯入你的標單或契約', desc: 'PCCES XML、PDF 或 Word' },
  { num: '02', title: '看 AI 抽出的履約要求', desc: '附條號、頁碼與信賴度，逐條核定' },
  { num: '03', title: '跑一期估驗計價', desc: '數量、累計百分比與金額由引擎計算' },
  { num: '04', title: '看三方各自的畫面', desc: '同一份資料，三種可見範圍' },
];
---

<section class="section cta">
  <div class="wrap split-wide">
    <div>
      <h2 class="cta-h2">用你自己的案子看一次</h2>
      <p class="cta-desc">
        30 分鐘線上示範。帶一份 PCCES 標單或契約 PDF，我們現場匯入，走完一次「文件 → 履約要求 → 工項 → 估驗」，不用你先簽任何東西。
      </p>
      {
        SITE.showPipelineNote && (
          <p class="cta-pipeline">目前有兩家建築師事務所與一個政府機關在導入洽談中。</p>
        )
      }
      <div class="cta-actions">
        <a class="btn cta-primary" href="/demo/">{SITE.ctaLabel}</a>
        <a class="cta-secondary" href={`mailto:${SITE.contactEmail}`}>
          <Icon name="mail" size={16} />{SITE.contactEmail}
        </a>
      </div>
    </div>

    <div class="cta-card">
      <div class="cta-card-title">示範會走完這四步</div>
      <div class="cta-steps">
        {
          steps.map((s) => (
            <div class="cta-step">
              <span class="num cta-step-num">{s.num}</span>
              <div>
                <div class="cta-step-title">{s.title}</div>
                <div class="cta-step-desc">{s.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* 文字色對 --dark-bg 的實算:--dark-text 15.63、--dark-text-2 10.10、--dark-blue-text 7.82 */
  .cta {
    background: var(--dark-bg);
    color: var(--dark-text);
  }

  .cta-h2 {
    font-size: clamp(var(--text-title1), 4vw, var(--text-headline));
    line-height: 1.15;
    letter-spacing: var(--text-headline--letter-spacing);
    color: var(--dark-text);
  }

  .cta-desc {
    margin-top: 16px;
    font-size: var(--text-title3);
    letter-spacing: var(--text-title3--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--dark-text-2);
    max-width: 560px;
  }

  .cta-pipeline {
    margin-top: 14px;
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--dark-blue-text);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 28px;
  }

  /* 深底上的主鈕:尺寸與形狀由 .btn 提供,只換成深色 primary
     (--dark-primary-fg 對 --dark-blue 4.97、對 hover 6.24) */
  .cta-primary {
    background: var(--dark-blue);
    color: var(--dark-primary-fg);
  }
  .cta-primary:hover,
  .cta-primary:active {
    background: var(--dark-blue-hover);
    color: var(--dark-primary-fg);
  }

  /* 信箱是文字連結(--dark-blue-text 7.82),hover 加底線 */
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    color: var(--dark-blue-text);
  }
  .cta-secondary:hover { color: var(--dark-blue-text); }

  /* 深色磚:--dark-surface,不描邊。對 --dark-surface 的實算:
     --dark-text 12.80、--dark-text-2 8.28、--dark-blue-text 6.40 */
  .cta-card {
    border-radius: 16px;
    padding: 24px;
    background: var(--dark-surface);
  }

  .cta-card-title {
    font-size: var(--text-footnote);
    line-height: var(--text-footnote--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
    color: var(--dark-blue-text);
    font-weight: 600;
  }

  .cta-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }

  .cta-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .cta-step-num {
    font-family: var(--font-display);
    font-size: var(--text-footnote);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
    color: var(--dark-blue-text);
    width: 20px;
    flex: none;
  }

  .cta-step-title {
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-weight: 500;
    color: var(--dark-text);
  }

  .cta-step-desc {
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--dark-text-2);
    margin-top: 2px;
  }
</style>
