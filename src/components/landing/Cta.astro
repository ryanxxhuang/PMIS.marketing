---
// Landing 最後一段：深底（#041e49）CTA。視覺照 handoff「PMIS.ai 官網.dc.html」
// 第 523–546 行的原型 1:1 重建，inline style 改寫成下方 scoped class，值未做任何調整。
//
// 版面沿用 global.css：.section（上下 clamp(56px,8vw,88px)）＋ .wrap（1180px／左右 24px）
// ＋ .split-wide（1.15fr 1fr、gap 56px、920px 以下收單欄）。
// CTA 是頁面最後一段，原型沒有下緣線 —— .cta 覆寫掉 .section 的 border-bottom。
//
// 按鈕不用 global 的 .btn-primary／.btn-outline：那組是亮底上的實心主色鈕，
// README「hover」一節指定深底上改用淺藍鈕（#a8c7fa 底 / hover #c2d9fd）。
//
// showPipelineNote 為 false 時整行洽談狀態不輸出（原型的 <sc-if>）。
import { SITE } from '../../config';

const steps = [
  { num: '01', title: '匯入你的標單或契約', desc: 'PCCES XML、PDF 或 Word' },
  { num: '02', title: '看 AI 抽出的履約要求', desc: '附條號、頁碼與信賴度，逐條核定' },
  { num: '03', title: '跑一期估驗計價', desc: '數量、累計百分比與金額由引擎計算' },
  { num: '04', title: '看三方各自的畫面', desc: '同一份資料，三種可見範圍' },
];
---

<section class="section cta">
  <div class="wrap split-wide">
    <div>
      <h2 class="cta-h2">用你自己的案子看一次</h2>
      <p class="cta-desc">
        30 分鐘線上示範。帶一份 PCCES 標單或契約 PDF，我們現場匯入，走完一次「文件 → 履約要求 → 工項 → 估驗」，不用你先簽任何東西。
      </p>
      {
        SITE.showPipelineNote && (
          <p class="cta-pipeline">目前有兩家建築師事務所與一個政府機關在導入洽談中。</p>
        )
      }
      <div class="cta-actions">
        <a class="cta-primary" href="/demo">
          {SITE.ctaLabel}<span class="msy cta-icon" aria-hidden="true">arrow_forward</span>
        </a>
        <a class="cta-secondary" href={`mailto:${SITE.contactEmail}`}>
          <span class="msy cta-icon" aria-hidden="true">mail</span>{SITE.contactEmail}
        </a>
      </div>
    </div>

    <div class="cta-card">
      <div class="cta-card-title">示範會走完這四步</div>
      <div class="cta-steps">
        {
          steps.map((s) => (
            <div class="cta-step">
              <span class="num cta-step-num">{s.num}</span>
              <div>
                <div class="cta-step-title">{s.title}</div>
                <div class="cta-step-desc">{s.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-accent-900);
    color: #fff;
    border-bottom: 0;
  }

  .cta-h2 {
    font-size: clamp(30px, 4vw, 38px);
    line-height: 1.3;
    color: #fff;
  }

  .cta-desc {
    margin: 18px 0 0;
    font-size: clamp(15px, 1.6vw, 15.5px);
    line-height: 1.9;
    color: #c2d9fd;
    max-width: 560px;
  }

  .cta-pipeline {
    margin: 18px 0 0;
    font-size: 13px;
    line-height: 1.8;
    color: #a8c7fa;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  /* 深底上的兩顆鈕：淺藍實心 + 灰框淺藍字（global.css 的 a 預設色與底線在此不適用） */
  .cta-primary {
    height: 48px;
    padding: 0 26px;
    border-radius: 100px;
    background: #a8c7fa;
    color: #062e6f;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .cta-primary:hover {
    background: #c2d9fd;
    color: #062e6f;
    text-decoration: none;
  }

  .cta-secondary {
    height: 48px;
    padding: 0 22px;
    border-radius: 100px;
    border: 1px solid #5f6368;
    color: #a8c7fa;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .cta-secondary:hover {
    background: #0d2f5f;
    color: #c2d9fd;
    text-decoration: none;
  }

  .cta-icon {
    font-size: 19px;
  }

  .cta-card {
    border: 1px solid #1f52a0;
    border-radius: 12px;
    padding: 24px;
    background: rgba(13, 47, 95, .5);
  }

  .cta-card-title {
    font-size: 12px;
    color: #a8c7fa;
    font-weight: 500;
  }

  .cta-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }

  .cta-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .cta-step-num {
    font-family: var(--font-display);
    font-size: 13px;
    color: #a8c7fa;
    width: 20px;
    flex: none;
  }

  .cta-step-title {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
  }

  .cta-step-desc {
    font-size: 12.5px;
    color: #c2d9fd;
    line-height: 1.75;
    margin-top: 3px;
  }
</style>
