---
// Landing 最後一段：深底 CTA。視覺照 handoff「PMIS.ai 官網.dc.html」
// 第 523–546 行的原型 1:1 重建，inline style 改寫成下方 scoped class。
// 顏色全部走 global.css 的 --dark-* token(值=產品深色模式),不再寫原型的海軍藍字面值。
//
// 版面沿用 global.css：.section（上下 clamp(56px,8vw,88px)）＋ .wrap（1180px／左右 24px）
// ＋ .split-wide（1.15fr 1fr、gap 56px、920px 以下收單欄）。
// CTA 是頁面最後一段，原型沒有下緣線 —— .cta 覆寫掉 .section 的 border-bottom。
//
// 按鈕不用 global 的 .btn-primary／.btn-outline：那組是亮底上的實心主色鈕，
// 深底上改用產品深色模式的 primary(--dark-blue 底 + --dark-primary-fg 深藍字,
// 不是藍底白字——白字對深色藍不過 AA,見 global.css)。
//
// showPipelineNote 為 false 時整行洽談狀態不輸出（原型的 <sc-if>）。
import { SITE } from '../../config';
import Icon from '../Icon.astro';

const steps = [
  { num: '01', title: '匯入你的標單或契約', desc: 'PCCES XML、PDF 或 Word' },
  { num: '02', title: '看 AI 抽出的履約要求', desc: '附條號、頁碼與信賴度，逐條核定' },
  { num: '03', title: '跑一期估驗計價', desc: '數量、累計百分比與金額由引擎計算' },
  { num: '04', title: '看三方各自的畫面', desc: '同一份資料，三種可見範圍' },
];
---

<section class="section cta">
  <div class="wrap split-wide">
    <div>
      <h2 class="cta-h2">用你自己的案子看一次</h2>
      <p class="cta-desc">
        30 分鐘線上示範。帶一份 PCCES 標單或契約 PDF，我們現場匯入，走完一次「文件 → 履約要求 → 工項 → 估驗」，不用你先簽任何東西。
      </p>
      {
        SITE.showPipelineNote && (
          <p class="cta-pipeline">目前有兩家建築師事務所與一個政府機關在導入洽談中。</p>
        )
      }
      <div class="cta-actions">
        <a class="cta-primary" href="/demo/">
          {SITE.ctaLabel}<Icon name="arrow_forward" size={19} class="cta-icon" />
        </a>
        <a class="cta-secondary" href={`mailto:${SITE.contactEmail}`}>
          <Icon name="mail" size={19} class="cta-icon" />{SITE.contactEmail}
        </a>
      </div>
    </div>

    <div class="cta-card">
      <div class="cta-card-title">示範會走完這四步</div>
      <div class="cta-steps">
        {
          steps.map((s) => (
            <div class="cta-step">
              <span class="num cta-step-num">{s.num}</span>
              <div>
                <div class="cta-step-title">{s.title}</div>
                <div class="cta-step-desc">{s.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--dark-bg);
    color: var(--dark-text);
    border-bottom: 0;
  }

  .cta-h2 {
    font-size: clamp(30px, 4vw, 38px);
    line-height: 1.3;
    color: var(--dark-text);
  }

  .cta-desc {
    margin: 18px 0 0;
    font-size: clamp(15px, 1.6vw, 15.5px);
    line-height: 1.9;
    color: var(--dark-text-2);
    max-width: 560px;
  }

  .cta-pipeline {
    margin: 18px 0 0;
    font-size: 13px;
    line-height: 1.8;
    color: var(--dark-blue-text);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  /* 深底上的兩顆鈕：深色 primary 實心 + 髮絲框淺藍字（global.css 的 a 預設色與底線在此不適用） */
  .cta-primary {
    height: 48px;
    padding: 0 26px;
    border-radius: 100px;
    background: var(--dark-blue);
    color: var(--dark-primary-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .cta-primary:hover {
    background: var(--dark-blue-hover);
    color: var(--dark-primary-fg);
    text-decoration: none;
  }

  .cta-secondary {
    height: 48px;
    padding: 0 22px;
    border-radius: 100px;
    border: 1px solid var(--dark-border);
    color: var(--dark-blue-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .cta-secondary:hover {
    background: var(--dark-blue-tint);
    color: var(--dark-blue-text);
    text-decoration: none;
  }

  .cta-card {
    border: 1px solid var(--dark-border);
    border-radius: 12px;
    padding: 24px;
    background: var(--dark-surface);
  }

  .cta-card-title {
    font-size: 12px;
    color: var(--dark-blue-text);
    font-weight: 500;
  }

  .cta-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }

  .cta-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .cta-step-num {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--dark-blue-text);
    width: 20px;
    flex: none;
  }

  .cta-step-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--dark-text);
  }

  .cta-step-desc {
    font-size: 12.5px;
    color: var(--dark-text-2);
    line-height: 1.75;
    margin-top: 3px;
  }
</style>
