---
// landing「資安與稽核」段落。文案逐字沿用 handoff「PMIS.ai 官網.dc.html」第 455–492 行。
//
// 外框用 global.css 的 .section / .wrap / .split / .kicker / .section-h2 /
// .section-desc / .btn-link / .num / Icon,其餘樣式在本檔 scoped。
//
// 「完整資安說明」在原型指向 handoff 檔「AI 邊界與資安.dc.html」,站上對應 /security
// (與 Header／Footer 的路由一致)。
//
// 右欄的測試數字對應產品既定原則,數值與說明不得改動。
import Icon from '../Icon.astro';

const guards = [
  {
    icon: 'lock',
    term: '資料列級安全性',
    desc: '每個查詢都在資料庫層被限制在使用者所屬的專案與角色範圍內。',
  },
  {
    icon: 'gavel',
    term: '狀態轉移 Guard',
    desc: '估驗、送審、缺失的狀態只能依契約流程前進，繞過介面也不行。',
  },
  {
    icon: 'history',
    term: '不可竄改稽核軌跡',
    desc: '由資料庫 Trigger 寫入，供審計、政風與監察調閱。',
  },
  {
    icon: 'hub',
    term: '佐證鏈',
    desc: '「這個結論是哪些文件、哪一頁支撐的」可以逐層點回去。',
  },
];

const tests = [
  { num: '761', desc: '單元測試項，涵蓋計價、期限與罰則等確定性引擎' },
  { num: '32', desc: '組資料庫測試，專門驗證資料列級安全性與狀態轉移' },
  { num: '38', desc: '端到端流程測試，含三角色實際後端冒煙測試' },
  { num: '16', desc: '個 AI 功能，每一個都能單獨開關與計量' },
];
---

<section class="section">
  <div class="wrap split">
    <div>
      <div class="kicker">資安與稽核</div>
      <h2 class="section-h2">安全邊界寫在資料庫裡</h2>
      <p class="section-desc">
        權限不是前端隱藏按鈕。多租戶的資料列級安全性（RLS）、狀態轉移 Guard Trigger 與 Audit Trigger
        是真正的邊界；前端隱藏只是體驗。
      </p>

      <div class="sec-list">
        {
          guards.map((guard) => (
            <div class="sec-item">
              <Icon name={guard.icon} size={20} class="sec-icon" />
              <p class="sec-text"><strong class="sec-term">{guard.term}</strong>：{guard.desc}</p>
            </div>
          ))
        }
      </div>

      <a class="btn-link sec-link" href="/security/">完整資安說明<Icon name="chevron_right" size={16} /></a>
    </div>

    <div class="tests">
      <div class="tests-title">這些邊界有測試在守</div>
      <div class="tests-list">
        {
          tests.map((test) => (
            <div class="tests-row">
              <div class="num tests-num">{test.num}</div>
              <div class="tests-desc">{test.desc}</div>
            </div>
          ))
        }
      </div>
      <p class="tests-foot">2026-08-25 基線，隨版本更新。示範時可以現場跑給你看。</p>
    </div>
  </div>
</section>

<style>
  .sec-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 28px;
  }

  .sec-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .sec-icon {
    color: var(--success); /* 圖形 6.58 對白底 */
    flex: none;
    margin-top: 2px;
  }

  /* --text-2 對 --surface 7.31 */
  .sec-text {
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .sec-term {
    font-weight: 600;
    color: var(--text);
  }

  .sec-link { margin-top: 20px; }

  /* 測試數字:灰磚。文字色對 --bg 的實算:--text 15.46、--text-2 6.71、--text-3 5.09 */
  .tests {
    border-radius: 16px;
    background: var(--bg);
    padding: 24px 26px;
  }

  .tests-title {
    font-size: var(--text-callout);
    line-height: var(--text-callout--line-height);
    letter-spacing: var(--text-callout--letter-spacing);
    font-weight: 600;
    color: var(--text-2);
  }

  .tests-list {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
  }

  .tests-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
  }
  /* 前三列有分隔線,最後一列沒有 */
  .tests-row:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  /* 數字吃 .num 的 tabular-nums;headline(40)級的統計數字 */
  .tests-num {
    font-family: var(--font-display);
    font-size: var(--text-headline);
    line-height: var(--text-headline--line-height);
    letter-spacing: var(--text-headline--letter-spacing);
    font-weight: 600;
    min-width: 84px;
    flex: none;
  }

  .tests-desc {
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-2);
  }

  .tests-foot {
    margin-top: 6px;
    font-size: var(--text-footnote);
    letter-spacing: var(--text-footnote--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-3);
  }
</style>
