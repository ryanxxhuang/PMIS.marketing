---
// Hero:版面照 UIUX/design_apple_style/Marketing.dc.html(Apple.com 語彙)——
// 置中的 chip、display 級大標、兩段副標、一顆藥丸主鈕 + 一個帶 chevron 的文字連結、
// 灰字信任列;下方的產品畫面坐在「上白下灰」的漸層帶上。
//
// 副標是同一段文案拆成兩個 <p>(在「草稿與清單。」句點處斷),字一個沒動:
// 設計稿就是「一句 20px 深字 + 一句 15px 灰字」的節奏,一整段 100 多字塞成一塊會糊掉。
//
// 產品畫面是從真實 App 截的圖(public/appshots/,由 PMIS repo 的 npm run capture:appshots
// 產生,見根目錄 README),不再手繪:手繪版每次產品改版就漂一次,截圖不會。
// 桌機 1440×900、手機 390×844,皆 2x。單一 <picture>:<source media> 讓瀏覽器只抓符合
// 視窗的那一張(以前是兩張 <img> 用 display 切換,<760px 仍會白載 380 KB 的桌機圖)。
// <source> 上也給 width/height,窄視窗保留的是手機圖的比例,不會先按桌機比例留位再跳版。
// 首屏 LCP 候選:eager + fetchpriority=high。
// 外框只是行銷 chrome(圓角+陰影,吃 global.css 的 token),內容是 App 本人。
import { SITE } from '../../config';
import Icon from '../Icon.astro';
---

<section id="top" class="hero">
  <div class="wrap hero-copy">
    <div class="hero-chip">
      <Icon name="architecture" size={14} class="hero-chip-icon" />公共工程 · 機關／監造／廠商三方協作
    </div>
    <h1 class="hero-h1">重複的內業，AI 先做第一遍。<br />判定與簽名，還是你的。</h1>
    <p class="hero-lede">送審審查、契約履約要求、估驗對量、監造報表——公共工程每週都在做的內業，機關、監造與廠商三方各自的 Agent 先產出草稿與清單。</p>
    <p class="hero-desc">金額由程式算；AI 從契約與規範抽出的每一條履約要求，引註都由程式回原文逐字比對過。你做的是改、是核、是簽。</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/demo/">{SITE.ctaLabel}</a>
      <a class="btn-link" href="/features/">功能全覽<Icon name="chevron_right" size={16} /></a>
    </div>
    <div class="hero-trust">
      <span><Icon name="shield" size={15} />資通系統防護基準 · 普通級</span>
      <span><Icon name="location_on" size={15} />個資境內存放，未境外傳輸</span>
      <span><Icon name="history" size={15} />操作全程留存稽核軌跡</span>
    </div>
  </div>

  <div class="hero-stage">
    <picture class="hero-shot">
      <source
        media="(max-width: 759px)"
        srcset="/appshots/dashboard-phone@2x.png"
        width="390"
        height="844"
      />
      <img
        src="/appshots/dashboard-desktop@2x.png"
        width="1440"
        height="900"
        alt="GovAgent 監造角色的今日待辦。先問球在誰手上(現在輪到我、等待對方、今天已完成),清單列出待監造審定的施工計畫與材料送審、待回覆的 RFI、查驗不合格複查與監造月報,以及風險警示:進度落後、試體逾期未試驗、缺失逾期未結案。桌機版側欄標出各類件數,手機版底部導覽列是輪到我、現場、審查、金流"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>

<style>
  .hero {
    background: var(--surface);
    padding-top: clamp(48px, 6vw, 64px);
  }

  /* 文案全部置中(Marketing.dc.html) */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* chip:--bg 填色 + 半像素 --border 描邊;字與圖示 --text-3(對 --bg 5.09) */
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 14px;
    border-radius: 100px;
    background: var(--bg);
    box-shadow: inset 0 0 0 .5px var(--border);
    color: var(--text-3);
    font-size: var(--text-footnote);
    line-height: var(--text-footnote--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
  }

  /* display 54/62 是上限,窄視窗隨 7vw 下探到 title1 28;
     行高用比例(62/54=1.15),clamp 中段才不會用到 62px 的固定行高 */
  .hero-h1 {
    font-size: clamp(var(--text-title1), 7vw, var(--text-display));
    line-height: 1.15;
    letter-spacing: var(--text-display--letter-spacing);
    margin-top: 22px;
    max-width: 940px;
    text-wrap: balance;
  }

  /* 第一句 title3/深字(設計稿 20/30),第二句 callout/--text-3(5.54 對白底) */
  .hero-lede {
    margin-top: 20px;
    max-width: 720px;
    font-size: var(--text-title3);
    letter-spacing: var(--text-title3--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text);
  }
  .hero-desc {
    margin-top: 12px;
    max-width: 660px;
    font-size: var(--text-callout);
    letter-spacing: var(--text-callout--letter-spacing);
    line-height: var(--leading-prose);
    color: var(--text-3);
  }

  /* 一主一輔:主鈕與文字連結由 global.css 的 .btn / .btn-link 提供 */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 26px;
    margin-top: 26px;
  }

  /* 信任列:footnote/--text-3(5.54),圖示同色(圖形門檻 3:1 也過) */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 26px;
    margin-top: 24px;
    font-size: var(--text-footnote);
    line-height: var(--text-footnote--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
    color: var(--text-3);
  }
  .hero-trust > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ---------- 產品畫面:真實 App 截圖 ----------
     漸層帶:上 44% 白、下 56% --bg(Marketing.dc.html),畫面「坐」在灰底上;
     底部留白讓灰底延伸到下一段之前。圖是流體的(width:100% + height:auto,
     比例由 <img>/<source> 的 width/height 保留)。 */
  .hero-stage {
    margin-top: 46px;
    padding: 0 24px clamp(40px, 5vw, 64px);
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface) 44%, var(--bg) 44%, var(--bg) 100%);
  }

  /* 桌機外框:16px 圓角 + overlay 陰影(含半像素描邊),最寬 1020(設計稿) */
  .hero-shot {
    display: block;
    max-width: 1020px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: var(--shadow-overlay);
    background: var(--surface);
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 760px 以下 <source> 換成手機圖:外框改成手機機身(--dark-bg 細邊,內外圓角同心) */
  @media (max-width: 759px) {
    .hero-stage { margin-top: 36px; }
    .hero-shot {
      max-width: 330px;
      border: 8px solid var(--dark-bg);
      border-radius: 36px;
      background: var(--dark-bg);
    }
    .hero-shot img { border-radius: 28px; }
  }
</style>
