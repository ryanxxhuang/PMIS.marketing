---
// Hero(原型 1.1):kicker chip、H1、說明、雙鈕、信任列 + 產品畫面。
//
// 產品畫面是 1440×908 的固定內容整體等比縮放(不能用 calc(100cqi/1440px),
// CSS 不允許長度相除,所以用 media query 階梯調 --s);760px 以下換成
// 330px 手機版畫面,不縮放桌機版。兩張圖的切換照 README:桌機版
// display:block/none、手機版 none/flex。
import { SITE } from '../../config';
import Icon from '../Icon.astro';
import AppshotDesktop from './AppshotDesktop.astro';
import AppshotPhone from './AppshotPhone.astro';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <div class="hero-chip">
        <Icon name="architecture" size={15} class="hero-chip-icon" />公共工程 · 機關／監造／廠商三方協作
      </div>
      <h1 class="hero-h1">重複的內業，AI 先做第一遍。<br />判定與簽名，還是你的。</h1>
      <p class="hero-desc">送審審查、契約履約要求、估驗對量、監造報表——公共工程每週都在做的內業，機關、監造與廠商三方各自的 Agent 先產出草稿與清單。金額由程式算；AI 從契約與規範抽出的每一條履約要求，引註都由程式回原文逐字比對過。你做的是改、是核、是簽。</p>
      <div class="hero-actions">
        <a class="btn btn-primary hero-cta" href="/demo/">{SITE.ctaLabel}<Icon name="arrow_forward" size={18} class="hero-btn-icon" /></a>
        <a class="btn btn-outline hero-alt" href="/features/"><Icon name="grid_view" size={18} class="hero-btn-icon" />功能全覽</a>
      </div>
      <div class="hero-trust">
        <span><Icon name="shield" size={17} class="hero-trust-icon" />資通系統防護基準 · 普通級</span>
        <span><Icon name="location_on" size={17} class="hero-trust-icon" />個資境內存放，未境外傳輸</span>
        <span><Icon name="history" size={17} class="hero-trust-icon" />操作全程留存稽核軌跡</span>
      </div>
    </div>

    <div class="only-wide" role="img" aria-label="GovAgent 產品畫面:監造角色的今日待辦,含指標卡、待辦清單、風險警示與 AI 已代辦">
      <div class="appshot">
        <div class="appshot-scale">
          <AppshotDesktop />
        </div>
      </div>
    </div>

    <div class="only-narrow" role="img" aria-label="GovAgent 手機版畫面:今日待辦清單與 AI 已代辦摘要">
      <AppshotPhone />
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    padding: clamp(48px, 7vw, 80px) 0 0;
    border-bottom: 1px solid var(--g-line);
  }

  .hero-copy { max-width: 800px; }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 28px;
    padding: 0 14px;
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--blue-soft);
    color: var(--blue-text);
    font-size: 11.5px;
    font-weight: 500;
  }
  .hero-chip-icon {
    color: var(--blue);
  }

  /* 上限是 token 的 display 階(行銷站 hero 專用,比產品 title1 大) */
  .hero-h1 {
    font-size: clamp(32px, 5.4vw, var(--text-display));
    line-height: 1.18;
    margin: 22px 0 0;
  }

  .hero-desc {
    margin: 22px 0 0;
    font-size: clamp(15px, 1.6vw, 16.5px);
    line-height: 1.85;
    color: var(--color-neutral-800);
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-cta {
    height: 46px;
    padding: 0 26px;
    font-size: 15px;
    box-shadow: var(--shadow-btn);
  }
  .hero-alt {
    height: 46px;
    padding: 0 22px;
    font-size: 15px;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 26px;
    font-size: 12.5px;
    color: var(--color-neutral-700);
  }
  .hero-trust > span {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .hero-trust-icon {
    color: var(--success);
  }

  /* ---------- 產品畫面:1440×908 整體等比縮放 ---------- */

  /* 縮放階梯:≥1168px 時內容 1120px 寬 */
  .only-wide { --s: 0.7778; margin-top: clamp(36px, 5vw, 52px); }
  @media (max-width: 1167px) { .only-wide { --s: 0.6778; } }
  @media (max-width: 1023px) { .only-wide { --s: 0.5917; } }
  @media (max-width: 899px)  { .only-wide { --s: 0.4944; } }

  .appshot {
    width: calc(1440px * var(--s));
    height: calc(908px * var(--s));
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-card);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom: 0;
    box-shadow: var(--shadow-overlay);
    background: var(--surface);
  }
  .appshot-scale {
    width: 1440px;
    height: 908px;
    transform: scale(var(--s));
    transform-origin: top left;
  }

  /* 760px 以下換手機版畫面 */
  .only-narrow { display: none; }
  @media (max-width: 759px) {
    .only-wide { display: none; }
    .only-narrow {
      display: flex;
      justify-content: center;
      margin-top: 36px;
      padding-bottom: 40px;
    }
  }
</style>
