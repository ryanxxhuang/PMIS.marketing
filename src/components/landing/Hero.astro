---
// Hero(原型 1.1):kicker chip、H1、說明、雙鈕、信任列 + 產品畫面。
//
// 產品畫面是從真實 App 截的圖(public/appshots/,由 PMIS repo 的 npm run capture:appshots
// 產生,見根目錄 README),不再手繪:手繪版每次產品改版就漂一次,截圖不會。
// 桌機 1440×900、手機 390×844,皆 2x;760px 以下換手機版畫面,不縮放桌機版。
// 外框只是行銷 chrome(圓角+陰影,吃 global.css 的 token),內容是 App 本人。
import { SITE } from '../../config';
import Icon from '../Icon.astro';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <div class="hero-chip">
        <Icon name="architecture" size={15} class="hero-chip-icon" />公共工程 · 機關／監造／廠商三方協作
      </div>
      <h1 class="hero-h1">重複的內業，AI 先做第一遍。<br />判定與簽名，還是你的。</h1>
      <p class="hero-desc">送審審查、契約履約要求、估驗對量、監造報表——公共工程每週都在做的內業，機關、監造與廠商三方各自的 Agent 先產出草稿與清單。金額由程式算；AI 從契約與規範抽出的每一條履約要求，引註都由程式回原文逐字比對過。你做的是改、是核、是簽。</p>
      <div class="hero-actions">
        <a class="btn btn-primary hero-cta" href="/demo/">{SITE.ctaLabel}<Icon name="arrow_forward" size={18} class="hero-btn-icon" /></a>
        <a class="btn btn-outline hero-alt" href="/features/"><Icon name="grid_view" size={18} class="hero-btn-icon" />功能全覽</a>
      </div>
      <div class="hero-trust">
        <span><Icon name="shield" size={17} class="hero-trust-icon" />資通系統防護基準 · 普通級</span>
        <span><Icon name="location_on" size={17} class="hero-trust-icon" />個資境內存放，未境外傳輸</span>
        <span><Icon name="history" size={17} class="hero-trust-icon" />操作全程留存稽核軌跡</span>
      </div>
    </div>

    {/* 桌機版在首屏,是 LCP 候選:eager + fetchpriority=high。width/height 給邏輯像素,
        瀏覽器先保留 16:10 的版位,圖到了不跳版(CLS)。 */}
    <div class="only-wide">
      <div class="appshot">
        <img
          src="/appshots/dashboard-desktop@2x.png"
          width="1440"
          height="900"
          alt="GovAgent 桌機版:監造角色的今日待辦。側欄先問球在誰手上(現在輪到我 9 件、等待對方 6 件、今天已完成),主欄列出待監造審定的施工計畫與材料送審、待回覆的 RFI、查驗不合格複查與監造月報,下方是風險警示卡:進度落後、試體逾期未試驗、缺失逾期未結案"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    {/* 手機版在 hero 文案之下、多半在首屏外:lazy。display:none 的 lazy 圖不會被抓,
        所以桌機視窗不會白載這張。 */}
    <div class="only-narrow">
      <div class="phone">
        <img
          src="/appshots/dashboard-phone@2x.png"
          width="390"
          height="844"
          alt="GovAgent 手機版:監造角色的今日待辦。頁首是專案名與三方,分段切換現在輪到我／等待對方／今天已完成,清單列出待審定的送審、待回覆的 RFI、查驗不合格複查與監造月報,底部導覽列是輪到我、現場、審查、金流"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    padding: clamp(48px, 7vw, 80px) 0 0;
    border-bottom: 1px solid var(--g-line);
  }

  .hero-copy { max-width: 800px; }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 28px;
    padding: 0 14px;
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--blue-soft);
    color: var(--blue-text);
    font-size: 11.5px;
    font-weight: 500;
  }
  .hero-chip-icon {
    color: var(--blue);
  }

  /* 上限是 token 的 display 階(行銷站 hero 專用,比產品 title1 大) */
  .hero-h1 {
    font-size: clamp(32px, 5.4vw, var(--text-display));
    line-height: 1.18;
    margin: 22px 0 0;
  }

  .hero-desc {
    margin: 22px 0 0;
    font-size: clamp(15px, 1.6vw, 16.5px);
    line-height: 1.85;
    color: var(--color-neutral-800);
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-cta {
    height: 46px;
    padding: 0 26px;
    font-size: 15px;
    box-shadow: var(--shadow-btn);
  }
  .hero-alt {
    height: 46px;
    padding: 0 22px;
    font-size: 15px;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 26px;
    font-size: 12.5px;
    color: var(--color-neutral-700);
  }
  .hero-trust > span {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .hero-trust-icon {
    color: var(--success);
  }

  /* ---------- 產品畫面:真實 App 截圖 ----------
     圖本身是流體的(width:100% + height:auto,比例由 width/height 屬性保留),
     不需要以前那套 transform: scale 階梯。桌機版最寬 1120px,與內容欄對齊。 */
  .only-wide { margin-top: clamp(36px, 5vw, 52px); }

  /* 桌機外框:視窗式——上緣圓角、坐在 hero 底線上(下緣不封口),深度靠 overlay 陰影 */
  .appshot {
    max-width: 1120px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--border-card);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    box-shadow: var(--shadow-overlay);
    background: var(--surface);
  }
  .appshot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 手機外框:深色細邊框當機身(取產品深色底 token),內外兩層圓角同心 */
  .phone {
    width: 100%;
    max-width: 330px;
    overflow: hidden;
    border: 8px solid var(--dark-bg);
    border-radius: 36px;
    background: var(--dark-bg);
    box-shadow: var(--shadow-overlay);
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 28px;
  }

  /* 760px 以下換手機版畫面 */
  .only-narrow { display: none; }
  @media (max-width: 759px) {
    .only-wide { display: none; }
    .only-narrow {
      display: flex;
      justify-content: center;
      margin-top: 36px;
      padding-bottom: 40px;
    }
  }
</style>
