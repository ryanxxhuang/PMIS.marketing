---
// ⚠️ 凍結(2026-09-11,Apple 改版):本檔是手繪的 W9 Google 版產品畫面。改版時刻意
// 不讓它吃新 token——只換顏色會變成「Google 版面配 Apple 顏色」的半套 mockup,比原樣更糟。
// 所以把用到的舊值就地寫死:色值、字型、字級,以及 Material Symbols 的 glyph 外框
// (下方 GLYPH,從已退場的訂閱字型抽出,viewBox 0 -960 960 960 是 Material 的座標系)。
// 整支維持原樣;等「從真實 App 產生截圖」的管線上線後整支退場,不要在這裡疊新東西,
// 也不要改用 Icon.astro(退場時會留孤兒)。
// Hero 產品畫面(手機版):330px 寬、9px 深色邊框的今日待辦畫面。
// 760px 以下取代桌機版,不是縮放桌機版(README 明確要求)。
const rows = [
  { tone: 'warn', meta: '還有 1 天 · SUB-002', title: '4F 以上結構體施工計畫', sub: '待監造審定' },
  { tone: 'open', meta: '還有 4 天 · RFI-002', title: '3F 樑柱接頭鋼筋與機電套管衝突', sub: '待監造／設計回覆' },
  { tone: 'danger', meta: '逾期 2 天 · DEF-018', title: '3F 西側牆面蜂窩未改善', sub: '待廠商改善' },
];

const GLYPH = {
  auto_awesome: '<path d="M760 -600 710 -710 600 -760 710 -810 760 -920 810 -810 920 -760 810 -710ZM760 -40 710 -150 600 -200 710 -250 760 -360 810 -250 920 -200 810 -150ZM360 -160 260 -380 40 -480 260 -580 360 -800 460 -580 680 -480 460 -380ZM360 -354 400 -440 486 -480 400 -520 360 -606 320 -520 234 -480 320 -440ZM360 -480Z"/>',
};
---

<div class="phone">
  <div class="num status"><span>9:41</span><span>6 件待辦</span></div>
  <div class="ph-head">
    <div class="ph-proj">○○市立圖書館新建工程</div>
    <div class="ph-title">今日待辦</div>
  </div>
  {
    rows.map((r) => (
      <div class="ph-row">
        <span class:list={['ph-dot', `ph-dot--${r.tone}`]}></span>
        <div>
          <div class:list={['num', 'ph-meta', `ph-meta--${r.tone}`]}>{r.meta}</div>
          <div class="ph-item">{r.title}</div>
          <div class="ph-sub">{r.sub}</div>
        </div>
      </div>
    ))
  }
  <div class="ph-ai">
    <div class="ph-ai-label"><svg class="ph-ai-icon" width="1em" height="1em" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" set:html={GLYPH.auto_awesome} />AI 今日已代辦</div>
    <div class="ph-ai-text">日誌草稿 1 份 · 查驗草稿 2 件 · 審查意見 1 份</div>
  </div>
  <div class="ph-cta">
    <div class="ph-cta-btn">問 GovAgent：今天最該處理什麼？</div>
  </div>
</div>

<style>
  /* 凍結:body 的字型/字級/字距/字色已換成 Apple 版,這裡釘回 W9 的值(見檔首說明);
     其餘規則裡的色值同樣是舊 token 的字面值,不要改回 var()。 */
  .phone {
    width: 330px;
    background: #fff;
    border: 9px solid #202124;
    font-family: "Google Sans Text", "Noto Sans TC", system-ui, sans-serif;
    font-size: 14px;
    letter-spacing: normal;
    color: #202124;
    border-radius: 34px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(60, 64, 67, .3), 0 8px 24px 6px rgba(60, 64, 67, .12);
    display: flex;
    flex-direction: column;
  }

  .status {
    padding: 9px 16px 0;
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
    color: #5f6368;
  }

  .ph-head {
    padding: 12px 16px 10px;
    border-bottom: 1px solid #dadce0;
  }
  .ph-proj { font-size: 10.5px; color: #0842a0; }
  .ph-title {
    font-family: "Google Sans Display", "Google Sans", "Google Sans Text", "Noto Sans TC", system-ui, sans-serif;
    font-size: 19px;
    font-weight: 500;
    margin-top: 5px;
  }

  .ph-row {
    padding: 12px 16px;
    border-bottom: 1px solid #dadce0;
    display: flex;
    gap: 11px;
    align-items: flex-start;
  }
  .ph-dot {
    width: 7px;
    height: 7px;
    margin-top: 6px;
    flex: none;
  }
  .ph-dot--warn { background: #b06000; }
  .ph-dot--open { border: 1px solid #80868b; }
  .ph-dot--danger { background: #a50e0e; }
  .ph-meta { font-size: 9.5px; letter-spacing: .08em; }
  .ph-meta--warn { color: #b06000; }
  .ph-meta--open { color: #5f6368; }
  .ph-meta--danger { color: #a50e0e; }
  .ph-item { font-size: 12.5px; line-height: 1.55; margin-top: 3px; }
  .ph-sub { font-size: 11px; color: #5f6368; margin-top: 2px; }

  .ph-ai {
    padding: 13px 16px;
    background: #ecf3fe;
  }
  .ph-ai-label {
    font-size: 10.5px;
    color: #062e6f;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ph-ai-icon { font-size: 15px; color: #0b57d0; }
  .ph-ai-text {
    font-size: 12px;
    line-height: 1.75;
    margin-top: 6px;
    color: #062e6f;
  }

  .ph-cta {
    padding: 12px 16px 18px;
    background: #f8fafd;
  }
  .ph-cta-btn {
    height: 44px;
    border-radius: 22px;
    background: #0b57d0;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13.5px;
    font-weight: 500;
  }
</style>
