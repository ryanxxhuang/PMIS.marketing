---
// 共用頁尾(Apple.com 語彙:--bg 灰底、footnote 小字、灰色文字連結,不畫上緣線——
// 底色本身就是與內容的分界)。
//
// note:頁尾右側的輔助文字。landing／功能全覽／資安頁用預設值;
// 預約示範頁傳入「此表單為設計稿,尚未接後端。」(見 handoff 預約示範.dc.html)。
import { SITE } from '../config';

interface Props {
  note?: string;
}

const { note = '畫面中的專案、金額、人名與統計數字為示範資料。' } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      {/* 標誌 inline 是為了吃 --party-* token(三方三色),不改成引用 public/brand 的檔案 */}
      <span class="footer-mark"><svg width="24" height="24" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 12.4 L34.4 30.4 L13.6 30.4 Z" fill="none" stroke="var(--border)" stroke-width="3" stroke-linejoin="round"></path><circle cx="24" cy="12.4" r="5.2" fill="var(--party-contractor)"></circle><circle cx="34.4" cy="30.4" r="5.2" fill="var(--party-supervisor)"></circle><circle cx="13.6" cy="30.4" r="5.2" fill="var(--party-agency)"></circle></svg></span>
      <span class="footer-wordmark">GovAgent</span>
      <span class="footer-tagline">公共工程專案管理</span>
    </div>

    <nav class="footer-nav" aria-label="頁尾導覽">
      <a href="/features/">功能全覽</a>
      <a href="/security/">AI 邊界與資安</a>
      <a href="/demo/">預約示範</a>
      <a href={SITE.appUrl}>登入</a>
      <a href={`mailto:${SITE.contactEmail}`}>聯絡</a>
    </nav>

    <div class="footer-note">{note}</div>
  </div>

  {/* 機關法制／政風會問「gov-agent.ai 是不是官方網站」。這句原在舊站(c7afb85),
      Astro 重寫時遺失,2026-08-25 補回。公司登記名稱與統編待補。 */}
  <div class="footer-legal">
    <p>本網站由民間資訊服務廠商經營，非政府機關，與任何政府機關無隸屬或代理關係。</p>
  </div>
</footer>

<style>
  /* 全頁尾 footnote(12)級;文字色對 --bg 的實算:--text 15.46、--text-2 6.71、--text-3 5.09 */
  .site-footer {
    background: var(--bg);
    padding: 36px 24px 40px;
    font-size: var(--text-footnote);
    line-height: var(--text-footnote--line-height);
    letter-spacing: var(--text-footnote--letter-spacing);
    color: var(--text-3);
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: var(--text-body);
    letter-spacing: var(--text-body--letter-spacing);
    font-weight: 600;
    color: var(--text);
  }

  .footer-tagline { color: var(--text-3); }

  /* 連結是灰的(Apple 頁尾),hover 才加底線;不吃 global 的 a 藍色 */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  .footer-nav a { color: var(--text-2); }
  .footer-nav a:hover { color: var(--text); }

  .footer-legal {
    max-width: 1180px;
    margin: 20px auto 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .footer-legal p { line-height: var(--leading-prose); }

  /* a11y:768px 以下觸控目標 ≥ 44px。只撐高連結的可點區域,間距與字級不動。 */
  @media (max-width: 768px) {
    .footer-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
