---
// 共用頁面外殼：<head>、字型與圖示載入。
//
// 字型方案:
// - Noto Sans TC 從 Google Fonts 載入(family 名就是 "Noto Sans TC"，
//   fontsource 的 "Variable" 後綴問題不適用)。刻意不 self-host:那是 18 個
//   子集檔約 1.1 MB，託管成本高;而且中文字型的 fallback 是優雅的
//   (退到系統的蘋方／微軟正黑)，CDN 被擋時只是換一套字，不會壞掉。
// - Google Sans 系列非公開授權、不能 self-host:不發出請求，
//   只留在 font-family stack 裡，使用者本機有裝才吃到。
//
// 圖示方案:
// - Material Symbols Outlined 已 self-host 於 public/fonts/(@font-face 在
//   global.css)，這裡不發任何圖示相關的 CDN 請求。圖示用 ligature 名稱當
//   文字內容，CDN 被擋會直接顯示成 "shield"、"arrow_forward" 等英文字，
//   對禁外連 CDN 的機關內網是硬傷——理由與重抓訂閱檔的方式見 global.css。
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 錯誤頁等不該被索引的頁面:輸出 noindex,且不輸出 canonical/og:url
      (404 的 pathname 推出的 /404/ 本身會回 404,指過去等於宣告死連結) */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// canonical:site 設定於 astro.config.mjs
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b57d0" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GovAgent" />
    <meta property="og:locale" content="zh_TW" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="GovAgent:同一個工程，三方看到三份不一樣的數字" />
    {/* og.png 是 1080×1080 方圖;summary_large_image 的 2:1 裁切會切斷主標,故用 summary */}
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'GovAgent',
        description: '公共工程專案管理:廠商、監造、機關在同一份契約事實上協作。',
        url: Astro.site?.href,
        logo: new URL('/brand/app-icon-blue.svg', Astro.site).href,
      })}
    />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {/* 跳過導覽:視覺上隱藏,鍵盤 focus 時才出現。各頁 <main> 帶 id="main" */}
    <a class="skip-link" href="#main">跳至主要內容</a>
    <slot />
    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        height: 44px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        background: #fff;
        border: 1px solid var(--color-divider);
        border-radius: 0 0 8px 0;
        font-size: 14px;
        font-weight: 500;
        color: var(--color-accent);
      }
      .skip-link:focus {
        left: 0;
        text-decoration: none;
      }
      main:focus { outline: none; }
    </style>
  </body>
</html>
